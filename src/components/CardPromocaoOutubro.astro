---
import { promocaoOutubro as promocao } from '../data/promocaoOutubro';
---

<article class="bg-white dark:bg-gray-800 rounded-2xl shadow-lg overflow-hidden hover:shadow-xl transition-shadow border-2 border-accent-500 h-full flex flex-col" aria-label={promocao.titulo}>
  <a href={promocao.url} aria-label={`Ver detalhes: ${promocao.titulo}`}>
    <img src={promocao.imagem} alt="Promoção de outubro: transfer aeroporto ida e volta + city tour em carro de 7 lugares" width="1254" height="1254" class="w-full h-auto aspect-square object-contain" />
  </a>
  <div class="p-4 lg:p-5 flex flex-col flex-1 gap-3">
    <div class="bg-primary-50 dark:bg-primary-900/30 rounded-xl p-4 text-center">
      <p class="text-sm text-gray-500 dark:text-gray-400">De <del>R$ 1.599,00</del> por apenas</p>
      <p class="text-3xl font-extrabold text-primary-600 dark:text-primary-400">R$ 1.299,00</p>
    </div>
    <div class="flex flex-col gap-2 mt-auto">
      <a href={promocao.url} class="w-full bg-green-500 hover:bg-green-600 text-white font-bold py-3 px-4 rounded-xl transition-colors block text-center text-base shadow-md">RESERVE AGORA</a>
      <a href={promocao.whatsappUrl} target="_blank" rel="noopener noreferrer" class="w-full border-2 border-green-500 hover:bg-green-50 dark:hover:bg-green-900/20 text-green-600 dark:text-green-400 font-semibold py-3 px-4 rounded-xl transition-colors block text-center text-base">Fale no WhatsApp</a>
    </div>
  </div>
</article>
