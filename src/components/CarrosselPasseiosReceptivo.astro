---

<section id="passeios-receptivo" class="relative pb-12 lg:pb-20 pt-0 bg-white dark:bg-dark-900">
  <div class="container mx-auto px-4">
    <div class="text-center">
      <div class="flex items-center justify-center mb-6">
        <div class="h-px bg-gradient-to-r from-transparent via-primary-400 to-transparent flex-1 max-w-xs"></div>
        <h2 class="text-3xl lg:text-4xl font-bold text-gray-900 dark:text-white mx-8">
          Translados e <span class="text-primary-600 dark:text-primary-400">Passeios</span>
        </h2>
        <div class="h-px bg-gradient-to-r from-transparent via-primary-400 to-transparent flex-1 max-w-xs"></div>
      </div>
    </div>

    <div class="relative z-20">
      <div>
        <div id="lista-passeios-receptivo" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          <div class="w-full" data-passeio-card>
            <CardPromocaoOutubro />
          </div>
          {passeiosReceptivo.map((passeio, index) => (
            <div class="w-full" data-passeio-card hidden={index >= 3}>
              <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-lg hover:shadow-xl transition-all duration-300 overflow-hidden group h-full flex flex-col">
                <div class="relative h-52 lg:h-56 overflow-hidden">
                  <img 
                    src={passeio.image} 
                    alt={passeio.title}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                    loading="lazy"
                  />
                  <div class="absolute top-3 left-3">
                    <span class="bg-primary-600 text-white text-sm font-semibold px-3 py-1.5 rounded-full">
                      {passeio.category}
                    </span>
                  </div>
                </div>

                <div class="p-4 lg:p-5 flex-1 flex flex-col gap-2">
                  <h3 class="font-bold text-2xl lg:text-xl text-gray-900 dark:text-white leading-tight line-clamp-2 group-hover:text-primary-600 transition-colors">
                    {passeio.title}
                  </h3>
                  <p class="text-gray-600 dark:text-gray-400 text-lg lg:text-base leading-relaxed line-clamp-2">
                    {passeio.subtitle}
                  </p>

                  {passeio.tags && (
                    <div class="flex flex-wrap gap-2 mt-1">
                      {passeio.tags.slice(0, 2).map(tag => (
                        <span class="px-3 py-1 bg-primary-50 dark:bg-primary-900/30 text-primary-700 dark:text-primary-300 rounded-full text-sm font-medium line-clamp-1">
                          {tag}
                        </span>
                      ))}
                    </div>
                  )}

                  {EXIBIR_PRECOS && (<div class="border-t border-gray-100 dark:border-gray-700 pt-3 mt-auto space-y-3">
                    <div class:list={["grid gap-3", passeio.precoUnico ? "grid-cols-1" : "grid-cols-2"]}>
                      <div class="bg-gray-50 dark:bg-gray-700/50 rounded-lg p-2 text-center">
                        <p class="text-xs text-gray-500 dark:text-gray-400 font-medium">{passeio.label1}</p>
                        <p class="text-lg font-bold text-primary-600 dark:text-primary-400 mt-1">
                          R$ {passeio.price1.toFixed(2).replace('.', ',')}
                        </p>
                      </div>
                      {!passeio.precoUnico && (<div class="bg-gray-50 dark:bg-gray-700/50 rounded-lg p-2 text-center">
                        <p class="text-xs text-gray-500 dark:text-gray-400 font-medium">{passeio.label2}</p>
                        <p class="text-lg font-bold text-primary-600 dark:text-primary-400 mt-1">
                          R$ {passeio.price2.toFixed(2).replace('.', ',')}
                        </p>
                      </div>)}
                    </div>
                  </div>)}

                  <div class="flex flex-col gap-2 mt-auto">
                    <a
                      href={`/passeio/${passeio.slug}`}
                      class="w-full bg-green-500 hover:bg-green-600 text-white font-bold py-3 px-4 rounded-xl transition-colors duration-200 block text-center text-base shadow-md"
                    >
                      RESERVE AGORA
                    </a>
                    
                    <a
                      href={`https://wa.me/5554996474071?text=${encodeURIComponent((EXIBIR_PRECOS ? passeio.whatsappText : undefined) || `Olá! Gostaria de reservar o passeio: ${passeio.title}`)}`}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="w-full border-2 border-green-500 hover:bg-green-50 dark:hover:bg-green-900/20 text-green-600 dark:text-green-400 font-semibold py-3 px-4 rounded-xl transition-colors duration-200 block text-center text-base"
                    >
                      Fale no WhatsApp
                    </a>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

    </div>

    <div class="flex flex-wrap items-center justify-center gap-4 mt-6">
      <button id="ver-mais-passeios" type="button" aria-controls="lista-passeios-receptivo" class="bg-primary-600 hover:bg-primary-700 text-white font-semibold py-3 px-6 rounded-xl transition-colors">Ver mais</button>
      <button id="ver-menos-passeios" type="button" aria-controls="lista-passeios-receptivo" class="border-2 border-primary-600 text-primary-600 dark:text-primary-400 font-semibold py-3 px-6 rounded-xl transition-colors" hidden>Ver menos</button>
    </div>
  </div>


</section>

<style>
  [data-passeio-card][hidden], button[hidden] {
    display: none;
  }
</style>

<script>
  function initListaPasseios() {
    const list = document.getElementById('lista-passeios-receptivo');
    const more = document.getElementById('ver-mais-passeios');
    const less = document.getElementById('ver-menos-passeios');
    if (!list || !more || !less || list.dataset.initialized) return;
    list.dataset.initialized = 'true';
    const cards = Array.from(list.querySelectorAll<HTMLElement>('[data-passeio-card]'));
    const batchSize = 4;
    let visibleCount = Math.min(batchSize, cards.length);

    function updateCards() {
      cards.forEach((card, index) => { card.hidden = index >= visibleCount; });
      more.hidden = visibleCount >= cards.length;
      less.hidden = visibleCount <= batchSize;
    }

    more.addEventListener('click', () => {
      visibleCount = Math.min(visibleCount + batchSize, cards.length);
      updateCards();
      if (more.hidden) less.focus({ preventScroll: true });
    });
    less.addEventListener('click', () => {
      visibleCount = Math.max(batchSize, (Math.ceil(visibleCount / batchSize) - 1) * batchSize);
      updateCards();
      if (less.hidden) more.focus({ preventScroll: true });
      (less.hidden ? more : less).scrollIntoView({ block: 'nearest' });
    });
    updateCards();
  }

  initListaPasseios();
  document.addEventListener('astro:page-load', initListaPasseios);
</script>
