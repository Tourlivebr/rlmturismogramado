      <button 
        id="prev-btn-passeios-receptivo"
        class="absolute left-0 sm:left-2 lg:-left-2 top-1/2 -translate-y-1/2 -translate-x-0 sm:translate-x-0 lg:-translate-x-1/2 bg-white dark:bg-gray-800 shadow-lg shadow-black/10 dark:shadow-black/40 rounded-full flex items-center justify-center active:scale-95 hover:bg-primary-600 hover:text-white dark:hover:bg-primary-600 transition-all duration-200 z-30

               w-[54px] h-[54px] p-3
               sm:w-11 sm:h-11 sm:p-2
               lg:w-12 lg:h-12

               opacity-90 sm:opacity-0 sm:group-hover/carousel:opacity-100 sm:focus-within:opacity-100 sm:data-open:opacity-100
               translate-z-0 will-change-transform"
        aria-label="Anterior"
        type="button"
      >
        <svg class="w-6 h-6 sm:w-5 sm:h-5 text-gray-700 dark:text-gray-200 group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"></path>
        </svg>
      </button>
      
      <button 
        id="next-btn-passeios-receptivo"
        class="absolute right-0 sm:right-2 lg:-right-2 top-1/2 -translate-y-1/2 translate-x-0 sm:translate-x-0 lg:translate-x-1/2 bg-white dark:bg-gray-800 shadow-lg shadow-black/10 dark:shadow-black/40 rounded-full flex items-center justify-center active:scale-95 hover:bg-primary-600 hover:text-white dark:hover:bg-primary-600 transition-all duration-200 z-30

               w-[54px] h-[54px] p-3
               sm:w-11 sm:h-11 sm:p-2
               lg:w-12 lg:h-12

               opacity-90 sm:opacity-0 sm:group-hover/carousel:opacity-100 sm:focus-within:opacity-100 sm:data-open:opacity-100
               translate-z-0 will-change-transform"
        aria-label="Próximo"
        type="button"
      >
        <svg class="w-6 h-6 sm:w-5 sm:h-5 text-gray-700 dark:text-gray-200 group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"></path>
        </svg>
      </button>
    </div>

    <div id="indicators-passeios-receptivo" class="flex items-center justify-center mt-5 mb-2 gap-2.5 relative z-20 touch-manipulation">
    </div>
  </div>

  <div class="absolute bottom-0 left-0 w-full overflow-hidden leading-[0] z-10">
    <svg 
      viewBox="0 0 1200 120" 
      preserveAspectRatio="none" 
      class="relative block w-[calc(100%+1.3px)] h-[40px] lg:h-[60px]"
    >
      <path d="M0,0 C300,120 900,120 1200,0 L1200,120 L0,120 Z" class="fill-white dark:fill-gray-900"></path>
    </svg>
  </div>
</section>

<script>
  function initCarouselPasseiosReceptivo() {
    let currentSlide = 0;
    const carouselTrack = document.getElementById('carousel-track-passeios-receptivo');
    const viewport = document.getElementById('carousel-viewport-passeios-receptivo');
    const prevBtn = document.getElementById('prev-btn-passeios-receptivo');
    const nextBtn = document.getElementById('next-btn-passeios-receptivo');
    const indicatorsContainer = document.getElementById('indicators-passeios-receptivo');

    if (!carouselTrack || !indicatorsContainer) return;

    const visibleItems = [...carouselTrack.children];
    let isAnimating = false;

    function isMobile() {
      return window.matchMedia && window.matchMedia('(max-width: 640px)').matches;
    }

    function getSlidesPerView() {
      const width = window.innerWidth;
      if (width >= 1280) return 4;
      if (width >= 1024) return 3;
      if (width >= 640) return 2;
      return 1;
    }
    
    function getTotalSlides() {
      const slidesPerView = getSlidesPerView();
      return Math.max(1, Math.ceil(visibleItems.length - slidesPerView + 1));
    }

    function updateIndicators() {
      const totalSlides = getTotalSlides();
      const mobile = isMobile();
      indicatorsContainer.innerHTML = '';
      
      for (let i = 0; i < totalSlides; i++) {
        const indicator = document.createElement('button');
        const active = i === currentSlide;
        if (mobile) {
          indicator.className = `h-1.5 rounded-full transition-all duration-300 ease-out touch-manipulation ${
            active
              ? 'w-8 bg-primary-600 shadow-sm shadow-primary-600/40'
              : 'w-2 bg-gray-300 dark:bg-gray-600'
          }`;
        } else {
          indicator.className = `h-3 w-3 rounded-full transition-colors duration-200 touch-manipulation ${
            active ? 'bg-primary-600' : 'bg-gray-300 dark:bg-gray-600'
          }`;
        }
        indicator.setAttribute('aria-label', `Ir para slide ${i + 1}`);
        indicator.addEventListener('click', () => {
          if (isAnimating) return;
          currentSlide = i;
          updateCarousel();
        });
        indicatorsContainer.appendChild(indicator);
      }
    }
    
    function updateCarousel() {
      if (!visibleItems || visibleItems.length === 0) return;
      isAnimating = true;
      const firstItem = visibleItems[0];
      const itemWidth = firstItem.getBoundingClientRect().width;
      carouselTrack.style.transform = `translate3d(-${currentSlide * itemWidth}px, 0, 0)`;
      updateIndicators();
      setTimeout(() => { isAnimating = false; }, 900);
    }

    function nextSlide() {
      if (isAnimating) return;
      const totalSlides = getTotalSlides();
      currentSlide = (currentSlide + 1) % totalSlides;
      updateCarousel();
    }
    
    function prevSlide() {
      if (isAnimating) return;
      const totalSlides = getTotalSlides();
      currentSlide = (currentSlide - 1 + totalSlides) % totalSlides;
      updateCarousel();
    }

    nextBtn?.addEventListener('click', nextSlide);
    prevBtn?.addEventListener('click', prevSlide);

    let startX = 0;
    let startY = 0;
    let isDragging = false;
    let deltaX = 0;
    let deltaY = 0;
    let startTime = 0;
    let axisLocked = false;
    let isHorizontal = false;

    // Touch swipe MELHORADO (detecta eixo X vs Y + threshold progressivo)
    if (carouselTrack) {
      carouselTrack.style.touchAction = 'pan-y';
    }

    carouselTrack.addEventListener('touchstart', (e) => {
      if (!e.touches || e.touches.length === 0) return;
      startX = e.touches[0].clientX;
      startY = e.touches[0].clientY;
      deltaX = 0;
      deltaY = 0;
      isDragging = true;
      axisLocked = false;
      isHorizontal = false;
      startTime = Date.now();
      stopAutoPlay();
    }, { passive: true });

    carouselTrack.addEventListener('touchmove', (e) => {
      if (!isDragging || !e.touches || e.touches.length === 0) return;
      const cx = e.touches[0].clientX;
      const cy = e.touches[0].clientY;
      deltaX = startX - cx;
      deltaY = Math.abs(startY - cy);

      if (!axisLocked) {
        const dxAbs = Math.abs(deltaX);
        if (dxAbs > 10 || deltaY > 10) {
          axisLocked = true;
          isHorizontal = dxAbs >= deltaY;
        }
      }
      // Se for movimento vertical, NÃO interrompa o scroll do navegador
      if (axisLocked && !isHorizontal) {
        isDragging = false;
        return;
      }
      // Feedback visual enquanto arrasta (só no mobile)
      if (axisLocked && isHorizontal && isMobile() && carouselTrack && visibleItems[0]) {
        const itemWidth = visibleItems[0].getBoundingClientRect().width;
        const base = currentSlide * itemWidth;
        const overflow = Math.abs(deltaX) > itemWidth ? (deltaX > 0 ? 1 : -1) * itemWidth * 0.2 : 0;
        carouselTrack.style.transform = `translate3d(-${base + deltaX - overflow}px, 0, 0)`;
      }
    }, { passive: true });
    
    carouselTrack.addEventListener('touchend', (e) => {
      if (!isDragging) return;
      const elapsed = Date.now() - startTime;
      const absDx = Math.abs(deltaX);
      const firstItem = visibleItems[0];
      const itemWidth = firstItem ? firstItem.getBoundingClientRect().width : 200;

      // Só considera swipe em eixo HORIZONTAL (evita conflito scroll vertical da pagina)
      const triggerSwipe = axisLocked && isHorizontal && (
        absDx >= itemWidth * 0.2 || (elapsed < 280 && absDx >= 30)
      );

      if (triggerSwipe && absDx > 0) {
        if (deltaX > 0) {
          nextSlide();
        } else if (deltaX < 0) {
          prevSlide();
        }
      } else {
        // Nenhum swipe valido: retorna suavemente para posicao original
        if (isMobile()) {
          updateCarousel();
        }
      }
      
      deltaX = 0;
      isDragging = false;
      axisLocked = false;
      isHorizontal = false;
      
      setTimeout(() => {
        startAutoPlay();
      }, isMobile() ? 6000 : 2000);
    }, { passive: true });

    // Evita clique acidental em card apos swipe longo
    let lastSwipeTime = 0;
    carouselTrack.addEventListener('click', (ev) => {
      if (Date.now() - lastSwipeTime < 280 && Math.abs(deltaX) > 20) {
        ev.preventDefault();
        ev.stopPropagation();
      }
    }, true);

    let autoPlayInterval;
    function startAutoPlay() {
      stopAutoPlay();
      const mobile = isMobile();
      const interval = mobile ? 11000 : 5000; // <=== MOBILE MAIS LENTO: 11s vs desktop 5s
      autoPlayInterval = setInterval(() => {
        if (document.hidden || document.visibilityState === 'hidden') return;
        nextSlide();
      }, interval);
    }
    
    function stopAutoPlay() {
      if (autoPlayInterval) {
        clearInterval(autoPlayInterval);
        autoPlayInterval = undefined;
      }
    }

    // Pausa em qualquer interacao do usuario mobile
    viewport?.addEventListener('touchstart', stopAutoPlay, { passive: true });
    viewport?.addEventListener('touchend', stopAutoPlay, { passive: true });
    viewport?.addEventListener('touchcancel', stopAutoPlay, { passive: true });

    carouselTrack.addEventListener('mouseenter', stopAutoPlay);
    carouselTrack.addEventListener('mouseleave', startAutoPlay);
    carouselTrack.addEventListener('touchstart', () => { lastSwipeTime = Date.now(); }, { passive: true });

    // Pausa AUTOMATICAMENTE quando a aba nao estiver visivel (economia bateria mobile)
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        stopAutoPlay();
      } else {
        startAutoPlay();
      }
    });

    // ============== DESKTOP: SCROLL WHEEL no CARROSSEL (nunca mais trava a rolagem) ==============
    let lastWheelSlide2 = 0;
    function onWheelReceptivo(evt) {
      if (isAnimating) return;
      const dx = Math.abs(evt.deltaX);
      const dy = Math.abs(evt.deltaY);
      const isHorizontal = (dx > dy) || (evt.shiftKey && dy > 0);
      if (isHorizontal) {
        if (Date.now() - lastWheelSlide2 < 450) return;
        lastWheelSlide2 = Date.now();
        if (evt.deltaX > 1 || evt.deltaY > 1) {
          nextSlide();
        } else {
          prevSlide();
        }
      }
      // Vertical SEM PREVENT DEFAULT => rola pagina normal!
    }
    if (viewport) {
      viewport.addEventListener('wheel', onWheelReceptivo, { passive: true });
    }

    let resizeTimer = null;
    window.addEventListener('resize', () => {
      if (resizeTimer) clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => {
        currentSlide = 0;
        updateCarousel();
      }, 180);
    });

    updateCarousel();
    startAutoPlay();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCarouselPasseiosReceptivo);
  } else {
    initCarouselPasseiosReceptivo();
  }
</script>
