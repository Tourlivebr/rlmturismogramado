---
interface Props {
  passeioNome: string;
  passeioParcelas?: string;
  passeioPreco?: number;
  passeioPreco1?: number;
  passeioPreco2?: number;
  passeioLabel1?: string;
  passeioLabel2?: string;
  passeioTemFaixas?: boolean;
  passeioDuracao?: string;
  passeioHorarios?: string[];
  passeioCategoria?: string;
}
const {
  passeioNome,
  passeioParcelas,
  passeioPreco,
  passeioPreco1,
  passeioPreco2,
  passeioLabel1,
  passeioLabel2,
  passeioTemFaixas = false,
  passeioDuracao,
  passeioHorarios,
  passeioCategoria,
} = Astro.props;

const whatsappNumber = "5554993220552";

const precoInicial = passeioPreco1 !== undefined ? passeioPreco1 : (passeioPreco ?? 0);
const labelInicial = passeioLabel1 ?? passeioParcelas ?? '';

const formatarReal = (v: number) => `R$ ${v.toFixed(2).replace('.', ',')}`;
---

<div
  class="form-reserva-root"
  data-tem-faixas={passeioTemFaixas ? 'true' : 'false'}
  data-preco1={passeioPreco1 ?? ''}
  data-preco2={passeioPreco2 ?? ''}
  data-label1={passeioLabel1 ?? ''}
  data-label2={passeioLabel2 ?? ''}
>
  {(passeioDuracao || passeioHorarios || passeioCategoria) && (
    <div class="space-y-4 mb-5">
      {passeioDuracao && (
        <div class="flex justify-between">
          <span class="text-gray-600">Duração:</span>
          <span class="font-medium">{passeioDuracao}</span>
        </div>
      )}
      {passeioHorarios && passeioHorarios.length > 0 && (
        <div class="flex justify-between">
          <span class="text-gray-600">Horários:</span>
          <span class="font-medium">{passeioHorarios.join(', ')}</span>
        </div>
      )}
      {passeioCategoria && (
        <div class="flex justify-between">
          <span class="text-gray-600">Categoria:</span>
          <span class="font-medium">{passeioCategoria}</span>
        </div>
      )}
    </div>
  )}

  <!-- Seletor / Exibição de preço -->
  <div class="mb-5">
    {passeioTemFaixas && passeioPreco1 !== undefined && passeioPreco2 !== undefined && passeioLabel1 && passeioLabel2 ? (
      <div class="grid grid-cols-2 gap-2 mb-4">
        <button type="button" data-faixa="1" class="faixa-pessoas-btn sidebar-faixa-btn border-2 border-primary-500 bg-white rounded-xl p-3 text-center shadow-sm transition-all hover:shadow-md ring-2 ring-primary-500">
          <div class="text-gray-600 text-xs font-medium mb-1">{passeioLabel1}</div>
          <div class="text-xl font-bold text-primary-600">{formatarReal(passeioPreco1)}</div>
        </button>
        <button type="button" data-faixa="2" class="faixa-pessoas-btn sidebar-faixa-btn border-2 border-gray-200 bg-white rounded-xl p-3 text-center shadow-sm transition-all hover:shadow-md">
          <div class="text-gray-600 text-xs font-medium mb-1">{passeioLabel2}</div>
          <div class="text-xl font-bold text-primary-600">{formatarReal(passeioPreco2)}</div>
        </button>
      </div>
    ) : null}

    <div class="text-center">
      <div class="text-gray-600 text-sm mb-1 form-reserva-label">
        {passeioTemFaixas ? labelInicial : passeioParcelas}
      </div>
      <div class="text-3xl font-bold text-primary-600 form-reserva-valor">
        {formatarReal(passeioTemFaixas ? precoInicial : (passeioPreco ?? 0))}
      </div>
    </div>
  </div>

  <form class="space-y-4 form-reserva-form mb-4" onsubmit={`return window.__enviarReservaGeneric(event, String.raw\`${passeioNome}\`)`}>
    <h3 class="font-bold text-lg text-gray-900">Formulário de Reserva</h3>

    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Nome:</label>
      <input type="text" required name="formNome" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition" placeholder="Seu nome completo" />
    </div>

    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">WhatsApp:</label>
      <input type="tel" required name="formWhats" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition" placeholder="(00) 00000-0000" />
    </div>

    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Passeio:</label>
      <input type="text" readonly name="formPasseio" class="w-full px-3 py-2 border border-gray-200 bg-gray-50 rounded-lg text-gray-700 cursor-not-allowed" value={passeioNome} />
    </div>

    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Data:</label>
      <input type="date" required name="formData" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition" />
    </div>

    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Observação:</label>
      <textarea name="formObs" rows="3" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition resize-none" placeholder="Número de pessoas, ponto de encontro, horário, etc."></textarea>
    </div>

    <button type="submit" class="w-full bg-green-600 hover:bg-green-700 text-white font-bold py-3 px-6 rounded-lg transition-colors flex items-center justify-center space-x-2">
      <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
        <path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/>
      </svg>
      <span>Enviar reserva</span>
    </button>
  </form>

  <a 
    class="form-reserva-contato w-full bg-primary-600 hover:bg-primary-700 text-white font-bold py-3 px-6 rounded-lg transition-colors flex items-center justify-center space-x-2"
    data-base-text={`Olá! Gostaria de mais informações sobre o ${passeioNome}.`}
    data-whatsapp-direct="true"
    target="_blank"
    rel="noopener noreferrer"
    href={`https://wa.me/${whatsappNumber}?text=${encodeURIComponent(`Olá! Gostaria de mais informações sobre o ${passeioNome}.${passeioTemFaixas ? ` ${labelInicial}: ${formatarReal(precoInicial)}.` : (passeioPreco !== undefined ? ` Valor: ${formatarReal(passeioPreco)}${passeioParcelas ? ` (${passeioParcelas})` : ''}.` : '')}`)}`}
  >
    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.890-5.335 11.893-11.893A11.821 11.821 0 0020.885 3.488"/>
    </svg>
    <span>Contato direto</span>
  </a>

  <div class="text-center mt-2">
    <p class="text-sm text-gray-600">Resposta rápida garantida!</p>
  </div>
</div>

<script>
  const WHATSAPP = "5554993220552";
  const fmt = (v) => `R$ ${(Number(v) || 0).toFixed(2).replace('.', ',')}`;

  if (!(window as any).__enviarReservaGeneric) {
    (window as any).__enviarReservaGeneric = function(event: Event, passeioNome: string) {
      event.preventDefault();
      const form = event.target as HTMLFormElement;
      const el = form.elements as any;
      const nome = el.formNome?.value?.trim() || '';
      const whats = el.formWhats?.value?.trim() || '';
      const passeio = el.formPasseio?.value?.trim() || passeioNome;
      const data = el.formData?.value || '';
      const obs = el.formObs?.value?.trim() || '';

      // Pega faixa selecionada (label e preço) a partir do sidebar pai
      let faixaLabel = '';
      let faixaValor = '';
      const root = form.closest('.form-reserva-root');
      if (root) {
        const lbl = root.querySelector('.form-reserva-label') as HTMLElement | null;
        const vlr = root.querySelector('.form-reserva-valor') as HTMLElement | null;
        if (lbl?.textContent) faixaLabel = lbl.textContent.trim();
        if (vlr?.textContent) faixaValor = vlr.textContent.trim();
      }

      const formatarData = (d: string) => {
        if (!d) return '';
        const [ano, mes, dia] = d.split('-');
        return `${dia}/${mes}/${ano}`;
      };

      const linhas = [
        `*Nova solicitação de reserva:*`,
        '',
        `*Nome:* ${nome}`,
        `*WhatsApp:* ${whats}`,
        `*Passeio:* ${passeio}`,
      ];
      if (faixaLabel && faixaValor) {
        linhas.push(`*Faixa:* ${faixaLabel}`);
        linhas.push(`*Valor:* ${faixaValor}`);
      }
      if (data) linhas.push(`*Data:* ${formatarData(data)}`);
      if (obs) linhas.push(`*Observação:* ${obs}`);

      const url = `https://wa.me/${WHATSAPP}?text=${encodeURIComponent(linhas.join('\n'))}`;
      window.open(url, '_blank');
      return false;
    };
  }

  // Inicializa o seletor do sidebar e escuta evento global vindo do seletor grande
  document.querySelectorAll('.form-reserva-root').forEach(root => {
    const temFaixas = (root as HTMLElement).dataset.temFaixas === 'true';
    if (!temFaixas) return;

    const p1 = Number((root as HTMLElement).dataset.preco1 || '0');
    const p2 = Number((root as HTMLElement).dataset.preco2 || '0');
    const l1 = (root as HTMLElement).dataset.label1 || '';
    const l2 = (root as HTMLElement).dataset.label2 || '';

    const labelEl = root.querySelector('.form-reserva-label') as HTMLElement | null;
    const valorEl = root.querySelector('.form-reserva-valor') as HTMLElement | null;
    const contatoEl = root.querySelector('.form-reserva-contato') as HTMLAnchorElement | null;
    const baseText = (contatoEl?.dataset as any)?.baseText || '';

    const btnsSidebar = root.querySelectorAll<HTMLButtonElement>('.sidebar-faixa-btn');

    const aplicarFaixa = (faixa: '1' | '2') => {
      const preco = faixa === '1' ? p1 : p2;
      const label = faixa === '1' ? l1 : l2;
      if (labelEl) labelEl.textContent = label;
      if (valorEl) valorEl.textContent = fmt(preco);

      // Atualiza botão contato direto com a faixa correta
      if (contatoEl) {
        const msg = `${baseText} ${label}: ${fmt(preco)}.`;
        contatoEl.href = `https://wa.me/${WHATSAPP}?text=${encodeURIComponent(msg)}`;
      }

      // Seletor pequeno no próprio sidebar
      btnsSidebar.forEach(b => {
        const ativo = b.dataset.faixa === faixa;
        b.classList.toggle('border-primary-500', ativo);
        b.classList.toggle('ring-2', ativo);
        b.classList.toggle('ring-primary-500', ativo);
        b.classList.toggle('border-gray-200', !ativo);
      });
    };

    btnsSidebar.forEach(btn => {
      btn.addEventListener('click', () => {
        const faixa = btn.dataset.faixa as '1' | '2';
        aplicarFaixa(faixa);
        // Notifica o seletor grande (se houver) para sincronizar
        window.dispatchEvent(new CustomEvent('faixa-pessoas-mudou', { detail: { faixa, origem: 'sidebar' } }));
      });
    });

    // Escuta mudanças do seletor grande
    window.addEventListener('faixa-pessoas-mudou', ((e: CustomEvent) => {
      const faixa = e?.detail?.faixa as '1' | '2' | undefined;
      if (faixa) aplicarFaixa(faixa);
    }) as EventListener);
  });
</script>
