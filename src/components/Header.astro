---
import ServiceSearch from './ServiceSearch.astro';
const isHome = Astro.url.pathname === '/';
---
<header id="header" class:list={['site-header', { 'home-header': isHome }]}>
  <nav class="header-nav" aria-label="Navegação principal">
    <a href="/" class="header-logo" aria-label="Página inicial"><img src="/images/logo_p_rlmtur.png" alt="RLM Turismo" width="160" height="112" /></a>
    <button id="mobile-menu-button" type="button" aria-label="Abrir menu de navegação" aria-expanded="false" aria-controls="mobile-menu">
      <svg width="26" height="26" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16" /></svg>
    </button>
  </nav>
  <div id="mobile-menu" hidden>
    <nav aria-label="Menu de páginas">
      <a href="/#quem-sou">Início</a>
      <a href="/passeios">Passeios e Transfer</a>
      <a href="/ingressos">Ingressos e Atrações</a>
      <a href="/#depoimentos">Depoimentos</a>
      <a href="/#contato">Contato</a>
    </nav>
    <ServiceSearch id="menu-service-search" />
  </div>
</header>
<script>
  const header = document.getElementById('header')!;
  const button = document.getElementById('mobile-menu-button')!;
  const menu = document.getElementById('mobile-menu')!;
  const closeMenu = () => {
    menu.hidden = true;
    button.setAttribute('aria-expanded', 'false');
    button.setAttribute('aria-label', 'Abrir menu de navegação');
  };
  button.addEventListener('click', () => {
    const open = menu.hidden;
    menu.hidden = !open;
    button.setAttribute('aria-expanded', String(open));
    button.setAttribute('aria-label', open ? 'Fechar menu de navegação' : 'Abrir menu de navegação');
  });
  menu.querySelectorAll('a').forEach(link => link.addEventListener('click', closeMenu));
  document.addEventListener('click', event => { if (event.target instanceof Node && !header.contains(event.target)) closeMenu(); });
  document.addEventListener('keydown', event => { if (event.key === 'Escape' && !menu.hidden) { closeMenu(); button.focus(); } });
  const syncScroll = () => header.classList.toggle('scrolled', window.scrollY > 40);
  window.addEventListener('scroll', syncScroll, { passive: true });
  syncScroll();
</script>
<style>
  .site-header { position: fixed; inset: 0 0 auto; z-index: 50; background: #fff; transition: background .25s, box-shadow .25s; }
  .home-header { background: transparent; }
  .site-header.scrolled { background: #fff; box-shadow: 0 2px 15px #0001; }
  .header-nav { max-width: 1480px; margin: auto; padding: 12px 24px; height: 112px; display: flex; align-items: center; justify-content: space-between; }
  .header-logo img { width: auto; height: 88px; object-fit: contain; }
  button { display: grid; place-items: center; width: 48px; height: 48px; border: 1px solid #16465b60; border-radius: 50%; color: #16465b; background: transparent; }
  .home-header:not(.scrolled) button { border-color: #ffffff90; color: white; background: #ffffff15; }
  button:hover { background: #16465b15; }
  button:focus-visible { outline: 3px solid #81b595; outline-offset: 4px; }
  #mobile-menu { position: absolute; top: 100%; right: max(24px, calc((100vw - 1432px) / 2)); width: min(420px, calc(100% - 48px)); padding: 24px; border-radius: 20px; background: white; box-shadow: 0 12px 35px #0003; max-height: calc(100dvh - 130px); overflow-y: auto; }
  #mobile-menu nav { display: grid; margin-bottom: 18px; }
  #mobile-menu a { padding: 12px 8px; color: #16465b; border-bottom: 1px solid #e6edef; }
  #mobile-menu a:hover { background: #eef5f7; }
  @media (max-width: 767px) { .header-nav { height: 104px; padding: 12px 24px; } .header-logo img { height: 80px; } }
</style>
