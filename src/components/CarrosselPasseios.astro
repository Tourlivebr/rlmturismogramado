---
import ListaIngressos from './ListaIngressos.astro';
---
<section class="tickets-section" aria-labelledby="tickets-title">
  <div class="container mx-auto px-4">
    <div class="tickets-heading">
      <div><h2 id="tickets-title">Ingressos e Atrações</h2><p>Garanta seus ingressos para as principais atrações da região.</p></div>
      <a href="/ingressos">Ver todos os ingressos <span aria-hidden="true">→</span></a>
    </div>
    <ListaIngressos preview />
  </div>
</section>
<style>
  .tickets-section { padding: 32px 0 45px; background: #f0f4f1; }
  .tickets-heading { display: flex; align-items: center; justify-content: space-between; gap: 24px; margin-bottom: 24px; }
  h2 { color: #29352e; font-size: clamp(24px, 3vw, 32px); font-weight: 700; }
  p { margin-top: 5px; color: #646464; font-size: 14px; }
  .tickets-heading > a { color: #123e2a; font-size: 14px; font-weight: 600; }
  @media (max-width: 540px) { .tickets-heading { align-items: flex-start; flex-direction: column; gap: 12px; } }
</style>
