---
import ListaIngressos from './ListaIngressos.astro';
---
<section class="relative pt-0 pb-12 lg:pb-20 bg-white dark:bg-dark-900" aria-labelledby="tickets-title">
  <div class="container mx-auto px-4">
    <div class="text-center">
      <div class="flex items-center justify-center mb-6">
        <div class="h-px bg-gradient-to-r from-transparent via-primary-400 to-transparent flex-1 max-w-xs"></div>
        <h2 id="tickets-title" class="text-3xl lg:text-4xl font-bold text-gray-900 dark:text-white mx-8">
          Ingressos e <span class="text-primary-600 dark:text-primary-400">Atrações</span>
        </h2>
        <div class="h-px bg-gradient-to-r from-transparent via-primary-400 to-transparent flex-1 max-w-xs"></div>
      </div>
    </div>
    <ListaIngressos preview />
  </div>
</section>
