---
import { ingressos } from '../data/ingressos';
interface Props { preview?: boolean }
const { preview = false } = Astro.props;
---

<div class:list={['ticket-catalog', { 'ticket-preview': preview }]}>
  <div class="ticket-list" id={preview ? 'ticket-preview-list' : 'ticket-catalog-list'}>
    {ingressos.map((ingresso) => (
      <a class="ticket-row" href={ingresso.linkOficial} target="_blank" rel="noopener noreferrer">
        <img class="ticket-thumbnail" src={ingresso.imagem} alt="" width="140" height="125" loading="lazy" decoding="async" />
        <div class="ticket-information">
          <h3>{ingresso.titulo}</h3>
          <p class="ticket-description">{ingresso.subtitulo}</p>
          <p class="ticket-value">RESERVE AGORA</p>
        </div>
        <span class="ticket-open">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h16m-6-6 6 6-6 6" /></svg>
          <span class="sr-only">Ver ingresso</span>
        </span>
      </a>
    ))}
  </div>
  {preview && <div class="ticket-controls">
    <button type="button" data-ticket-more aria-controls="ticket-preview-list" aria-expanded="false">Ver mais →</button>
    <button type="button" data-ticket-less aria-controls="ticket-preview-list" hidden>Ver menos ↑</button>
  </div>}
</div>

<style>
  .ticket-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; font-family: Arial, Helvetica, sans-serif; }
  .ticket-row { display: flex; align-items: center; gap: 18px; min-width: 0; padding: 22px 18px; background: #fff; border: 1px solid #edf0ed; border-radius: 24px; box-shadow: 0 8px 25px #153b2510; text-decoration: none; color: #28352d; transition: box-shadow .2s, transform .2s; }
  .ticket-row:hover { box-shadow: 0 12px 30px #153b2520; transform: translateY(-2px); }
  .ticket-row:focus-visible, button:focus-visible { outline: 3px solid #c89a3c; outline-offset: 4px; }
  .ticket-thumbnail { width: 122px; height: 125px; flex-shrink: 0; border-radius: 18px; object-fit: cover; background: #edf1ed; }
  .ticket-information { flex: 1; min-width: 0; }
  h3 { margin: 0 0 10px; font-size: 19px; line-height: 1.2; font-weight: 700; color: #29352e; }
  .ticket-description { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; margin: 0; color: #697970; font-size: 13px; line-height: 1.45; }
  .ticket-value { margin: 12px 0 0; color: #123e2a; font-size: 14px; font-weight: 700; }
  .ticket-open { display: grid; place-items: center; flex-shrink: 0; width: 44px; height: 44px; border-radius: 15px; background: #eef3ef; color: #123e2a; }
  svg { width: 21px; height: 21px; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  .ticket-controls { display: none; text-align: center; margin-top: 24px; }
  button { min-height: 46px; padding: 12px 30px; border-radius: 999px; background: #123e2a; color: white; font: 600 14px Arial, Helvetica, sans-serif; border: 0; cursor: pointer; }
  button:hover { background: #1c573d; }
  [hidden] { display: none !important; }
  @media (max-width: 900px) { .ticket-list { grid-template-columns: 1fr; } }
  @media (max-width: 540px) {
    .ticket-list { gap: 12px; }
    .ticket-row { gap: 10px; padding: 14px 12px; border-radius: 20px; min-height: 136px; }
    .ticket-thumbnail { width: 88px; height: 106px; border-radius: 14px; }
    h3 { font-size: 15px; margin-bottom: 8px; line-height: 1.25; }
    .ticket-description, .ticket-value { font-size: 12px; }
    .ticket-value { margin-top: 9px; }
    .ticket-open { width: 30px; height: 36px; border-radius: 11px; }
    svg { width: 18px; height: 18px; }
    .ticket-preview .ticket-row:nth-child(n+5):not(.is-visible) { display: none; }
    .ticket-controls { display: flex; justify-content: center; gap: 12px; flex-wrap: wrap; }
  }
  @media (prefers-reduced-motion: reduce) { .ticket-row { transition: none; } .ticket-row:hover { transform: none; } }
</style>

<script>
  function initTickets() {
    document.querySelectorAll<HTMLElement>('.ticket-preview').forEach((catalog) => {
      if (catalog.dataset.initialized) return;
      const more = catalog.querySelector<HTMLButtonElement>('[data-ticket-more]');
      const less = catalog.querySelector<HTMLButtonElement>('[data-ticket-less]');
      if (!more || !less) return;
      catalog.dataset.initialized = 'true';
      const cards = Array.from(catalog.querySelectorAll<HTMLElement>('.ticket-row'));
      let count = 4;
      function update() {
        cards.forEach((card, index) => card.classList.toggle('is-visible', index < count));
        more!.hidden = count >= cards.length;
        less!.hidden = count <= 4;
        more!.setAttribute('aria-expanded', String(count > 4));
      }
      more.addEventListener('click', () => { count = Math.min(count + 4, cards.length); update(); if (more.hidden) less.focus({ preventScroll: true }); });
      less.addEventListener('click', () => { count = Math.max(4, Math.floor((count - 1) / 4) * 4); update(); more.focus({ preventScroll: true }); more.scrollIntoView({ block: 'nearest' }); });
      update();
    });
  }
  initTickets();
  document.addEventListener('astro:page-load', initTickets);
</script>
