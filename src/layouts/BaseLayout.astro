---
import WhatsAppButton from '../components/WhatsAppButton.astro';

export interface Props {
  title: string;
  description: string;
  image?: string;
  canonical?: string;
  noindex?: boolean;
  keywords?: string[];
}

const {
  title,
  description,
  image = '/images/logo_p_rlmtur.png',
  canonical,
  noindex = false,
  keywords = ['Gramado', 'Canela', 'Serra Gaúcha', 'turismo', 'translado', 'passeios', 'ingressos', 'RLM Turismo Gramado'],
} = Astro.props;

// Criar URLs de forma segura
const baseUrl = Astro.site?.toString() || 'https://rlmturismogramado.vercel.app/';
const canonicalURL = canonical || new URL(Astro.url.pathname, baseUrl).toString();
const socialImage = new URL(image, baseUrl).toString();

// Detecta tipo MIME e dimensões conhecidas do og:image (WhatsApp/Facebook usam isso)
const isJpg = image.toLowerCase().endsWith('.jpg') || image.toLowerCase().endsWith('.jpeg');
const isPng = image.toLowerCase().endsWith('.png');
const ogType = isJpg ? 'image/jpeg' : isPng ? 'image/png' : 'image/jpeg';
// Dimensões conhecidas dos nossos assets (WhatsApp prefere >= 300px, recomendado 1200x630)
const ogWidth =
  image.includes('og-default-1200x630') ? 1200 :
  image.includes('link_passeios1') ? 1600 :
  image.includes('logo') ? 512 : 1200;
const ogHeight =
  image.includes('og-default-1200x630') ? 630 :
  image.includes('link_passeios1') ? 900 :
  image.includes('logo') ? 512 : 630;
---

<!DOCTYPE html>
<html lang="pt-BR" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords.join(', ')} />
    <meta name="author" content="RLM Turismo Gramado" />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
    <link rel="canonical" href={canonicalURL} />
    
    <!-- Open Graph / Facebook / WhatsApp (WhatsApp respeita OG) -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="RLM Turismo Gramado" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:locale:alternate" content="en_US" />
    <meta property="og:locale:alternate" content="es_ES" />
    
    <!-- Imagem OG (obrigatória para WhatsApp) + sub-propriedades -->
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:secure_url" content={socialImage} />
    <meta property="og:image:type" content={ogType} />
    <meta property="og:image:width" content={ogWidth.toString()} />
    <meta property="og:image:height" content={ogHeight.toString()} />
    <meta property="og:image:alt" content={title} />
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@rlmturismogramado" />
    <meta name="twitter:creator" content="@rlmturismogramado" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={title} />
    
    <!-- WhatsApp específico: pré-carrega og:image no body (força cache) -->
    <link rel="preload" as="image" href={socialImage} imagesrcset="" imagesizes="" fetchpriority="high" />
    <link rel="image_src" href={socialImage} />
    
    <!-- Schema.org JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "TravelAgency",
      "name": "RLM Turismo Gramado",
      "alternateName": "Guia Turismo Serra Gaúcha",
      "description": description,
      "url": canonicalURL,
      "image": socialImage,
      "telephone": "+5554992460547",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Gramado",
        "addressRegion": "Rio Grande do Sul",
        "addressCountry": "BR"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": -29.3655,
        "longitude": -50.8243
      },
      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": [
            "Monday",
            "Tuesday",
            "Wednesday",
            "Thursday",
            "Friday",
            "Saturday",
            "Sunday"
          ],
          "opens": "00:00",
          "closes": "23:59"
        }
      ],
      "priceRange": "R$",
      "sameAs": [
        "https://www.instagram.com/rlmturismogramado//",
        "https://www.facebook.com/profile.php?id=61564872360952"
      ]
    })} />

    
    <style>
      :root {
        /* Paleta RLM Turismo — baseada na logo
           Primary: AMARO/TERRA dos vales (suave, fundo dourado — vinícolas / Serra Gaúcha)
           Accent:  DOURADO/ÂMBAR vibrante (borda + "TURISMO" da logo)
           Dark:    PRETO (textos RLM + GRAMADO da logo) */
        --clr-primary-50:  #FBF5EA;
        --clr-primary-100: #F4E9D0;
        --clr-primary-200: #EBD2A2;
        --clr-primary-300: #DFB76D;
        --clr-primary-400: #D4A14C;
        --clr-primary-500: #C48C3A;
        --clr-primary-600: #A97030;
        --clr-primary-700: #8B572A;
        --clr-primary:      #A97030;  /* amaro/terra dos vales — suave com fundo dourado */

        --clr-accent-50:  #FFFBEA;
        --clr-accent-100: #FFF3C4;
        --clr-accent-200: #FCE588;
        --clr-accent-300: #FADB5F;
        --clr-accent-400: #F7C948;
        --clr-accent-500: #F0B429;
        --clr-accent-600: #DE911D;
        --clr-accent:      #F0B429;  /* dourado âmbar vibrante — destaques e badges */

        --clr-dark-50:  #F5F5F5;
        --clr-dark-100: #E5E5E5;
        --clr-dark-300: #A3A3A3;
        --clr-dark-500: #404040;
        --clr-dark-700: #1F1F1F;
        --clr-dark-800: #1A1A1A;
        --clr-dark:      #1A1A1A;  /* preto textos RLM + GRAMADO */

        --clr-whatsapp: #25D366;
      }
      html {
        scroll-behavior: smooth;
      }
      ::selection {
        background: var(--clr-primary);
        color: #ffffff;
      }
    </style>
  </head>
  <body class="bg-white text-dark-800 font-sans antialiased">
    <slot />
    <WhatsAppButton />
  </body>
</html>