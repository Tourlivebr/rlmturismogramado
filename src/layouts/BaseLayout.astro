---
import WhatsAppButton from '../components/WhatsAppButton.astro';

export interface Props {
  title: string;
  description: string;
  image?: string;
  canonical?: string;
  noindex?: boolean;
  keywords?: string[];
}

const {
  title,
  description,
  image = '/images/serratransfer.png',
  canonical,
  noindex = false,
  keywords = ['Gramado', 'Canela', 'Serra Gaúcha', 'turismo', 'translado', 'passeios', 'ingressos', 'Serra Transfer'],
} = Astro.props;

// Criar URLs de forma segura
const baseUrl = Astro.site?.toString() || 'https://serratransfer.com.br';
const canonicalURL = canonical || new URL(Astro.url.pathname, baseUrl).toString();
const socialImage = new URL(image, baseUrl).toString();
---

<!DOCTYPE html>
<html lang="pt-BR" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords.join(', ')} />
    <meta name="author" content="Serra Transfer" />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
    <link rel="canonical" href={canonicalURL} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="Serra Transfer" />
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:site" content="@SerraTransfer" />
    
    <!-- Preload critical resources -->
    
    <!-- Schema.org JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "TravelAgency",
      "name": "Serra Transfer",
      "alternateName": "Guia Turismo Serra Gaúcha",
      "description": description,
      "url": canonicalURL,
      "image": socialImage,
      "telephone": "+5554993220552",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Gramado",
        "addressRegion": "Rio Grande do Sul",
        "addressCountry": "BR"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": -29.3655,
        "longitude": -50.8243
      },
      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": [
            "Monday",
            "Tuesday",
            "Wednesday",
            "Thursday",
            "Friday",
            "Saturday",
            "Sunday"
          ],
          "opens": "00:00",
          "closes": "23:59"
        }
      ],
      "priceRange": "R$",
      "sameAs": [
        "https://www.instagram.com/serratransfer/",
        "https://www.facebook.com/serratransfer"
      ]
    })} />

    
    <style>
      :root {
        /* Paleta RLM Turismo — baseada na logo
           Primary: LAVANDA (campos de lavanda da Serra Gaúcha / romantismo)
           Accent:  DOURADO (borda + "TURISMO" da logo)
           Dark:    PRETO (textos RLM + GRAMADO da logo) */
        --clr-primary-50:  #FAF7FF;
        --clr-primary-100: #F2EBFF;
        --clr-primary-200: #E4D4FF;
        --clr-primary-300: #CEB2FF;
        --clr-primary-400: #B084FF;
        --clr-primary-500: #9458FF;
        --clr-primary-600: #7A35F0;
        --clr-primary-700: #6A27D0;
        --clr-primary:      #7A35F0;  /* lavanda — campos de lavanda / romantismo Serra */

        --clr-accent-50:  #FBF5E6;
        --clr-accent-100: #F5E8C4;
        --clr-accent-200: #EED390;
        --clr-accent-300: #E6BC5B;
        --clr-accent-400: #DEA833;
        --clr-accent-500: #D4A24C;
        --clr-accent-600: #C28A2C;
        --clr-accent:      #D4A24C;  /* dourado borda + TURISMO logo */

        --clr-dark-50:  #F5F5F5;
        --clr-dark-100: #E5E5E5;
        --clr-dark-300: #A3A3A3;
        --clr-dark-500: #404040;
        --clr-dark-700: #1F1F1F;
        --clr-dark-800: #1A1A1A;
        --clr-dark:      #1A1A1A;  /* preto textos RLM + GRAMADO */

        --clr-whatsapp: #25D366;
      }
      html {
        scroll-behavior: smooth;
      }
      ::selection {
        background: var(--clr-primary);
        color: #ffffff;
      }
    </style>
  </head>
  <body class="bg-white text-dark-800 font-sans antialiased">
    <slot />
    <WhatsAppButton />
  </body>
</html>