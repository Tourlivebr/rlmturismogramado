---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ListaIngressos from '../components/ListaIngressos.astro';


---

<BaseLayout 
  title="Ingressos e Atrações | RLM Turismo Gramado - Gramado e Canela"
  description="Encontre os melhores ingressos para atrações em Gramado e Canela. Parques temáticos, museus e experiências únicas na Serra Gaúcha com a RLM Turismo Gramado!"
  keywords={['ingressos Gramado', 'ingressos Canela', 'atrações Serra Gaúcha', 'parques temáticos RS', 'RLM Turismo Gramado']}
  image="/images/link_ingressos.jpg"
>
  <Header />
  
  <main class="pt-20 lg:pt-24">
    <!-- Hero Section -->
    <section class="relative text-white py-8 lg:py-20">
      <!-- Background Image com scroll default (mobile) + local (desktop, evita bug bg-fixed iOS) -->
      <div class="absolute inset-0 z-0 bg-cover bg-center bg-no-repeat bg-scroll lg:bg-local" style="background-image: url('/images/link_ingressos.jpg');">
        <div class="absolute inset-0 bg-black/30"></div>
      </div>
      <div class="container relative z-10 mx-auto px-4 text-center">
        <div class="max-w-4xl mx-auto">
          <h1 class="text-5xl lg:text-7xl font-bold mb-6 leading-tight">Ingressos e Atrações</h1>
          <p class="text-xl lg:text-2xl text-primary-100 mb-8 leading-relaxed">
            Descubra as melhores atrações de Gramado e Canela
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
            <div class="flex items-center text-primary-100">
              <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              Ingressos garantidos
            </div>
            <div class="flex items-center text-primary-100">
              <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              Suporte especializado
            </div>
          </div>
        </div>
      </div>

      <!-- Divisor Boleado Suave -->
      <div class="absolute bottom-0 left-0 w-full overflow-hidden leading-[0] z-20">
        <svg 
          viewBox="0 0 1200 120" 
          preserveAspectRatio="none" 
          class="relative block w-[calc(100%+1.3px)] h-[30px] lg:h-[50px]"
        >
          <path d="M0,0 C300,120 900,120 1200,0 L1200,120 L0,120 Z" class="fill-gray-50 dark:fill-gray-900"></path>
        </svg>
      </div>
    </section>

    <!-- Filtros -->
    <section class="py-6 bg-gradient-to-r from-gray-50 to-gray-100 dark:from-gray-900 dark:to-gray-800">
      <div class="container mx-auto px-4">
      </div>
    </section>

    <!-- Grid de Ingressos -->
    <section class="py-20 bg-gradient-to-b from-white to-gray-50 dark:from-gray-900 dark:to-gray-800">
      <div class="container mx-auto px-4">
        <ListaIngressos />
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

