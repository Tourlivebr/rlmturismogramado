---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StarRating from '../components/StarRating.astro';

const passeio = {
  titulo: "Parque Terra Mágica Florybal",
  subtitulo: "Ingresso",
  categoria: "INGRESSOS E ATRAÇÕES",
  avaliacao: 4.57,
  totalAvaliacoes: 7,
  descricao: "Mergulhe em uma aventura jurássica no Parque Terra Mágica Florybal! Um parque temático único que combina dinossauros animatrônicos realistas com a beleza natural preservada da região. Caminhe por trilhas mágicas cercado por cachoeiras naturais e descubra criaturas pré-históricas que se movimentam e emitem sons, proporcionando uma experiência educativa e emocionante para toda a família.",
  inclusos: [
    "Ingresso para o parque",
    "Acesso a todas as trilhas temáticas",
    "Interação com dinossauros animatrônicos",
    "Visita às cachoeiras naturais",
    "Área de recreação infantil"
  ],
  duracao: "3 horas",
  horarios: ["08:30", "13:30", "15:00"],
  galeria: [
    "https://coresg-normal.trae.ai/api/ide/v1/text_to_image?prompt=Magical%20family%20theme%20park%20entrance%20with%20giant%20realistic%20roaring%20dinosaur%20sculpture%20and%20lush%20green%20forest%2C%20Serra%20Gaucha%20Brazil%20tourist%20attraction&image_size=landscape_16_9",
    "https://coresg-normal.trae.ai/api/ide/v1/text_to_image?prompt=Tiger%20cavern%20theme%20cave%20interior%20magical%20kingdom%20Florybal%20park%20decoration%20mystical%20atmosphere&image_size=landscape_16_9",
    "https://coresg-normal.trae.ai/api/ide/v1/text_to_image?prompt=Outdoor%20theater%20facade%20with%20fantasy%20medieval%20style%20design%2C%20Florybal%20magical%20park%20dream%20theater&image_size=landscape_16_9",
    "https://coresg-normal.trae.ai/api/ide/v1/text_to_image?prompt=Kids%20riding%20dinosaur%20movable%20carousel%20ride%20with%20colorful%20decoration%20family%20amusement%20park&image_size=landscape_16_9",
    "https://coresg-normal.trae.ai/api/ide/v1/text_to_image?prompt=Chocolate%20factory%20interactive%20tour%20exhibit%2C%20sweet%20themed%20attraction%20for%20children%20delicious%20display&image_size=landscape_16_9",
    "https://coresg-normal.trae.ai/api/ide/v1/text_to_image?prompt=Cinema%207D%20motion%20theater%20building%20exterior%20family%20park%20immersive%20movie%20experience%20attraction&image_size=landscape_16_9",
    "https://coresg-normal.trae.ai/api/ide/v1/text_to_image?prompt=Aerobike%20sky%20bike%20ride%20cable%20rail%20amusement%20park%20attraction%20above%20trees%20adventure%20park&image_size=landscape_16_9",
    "https://coresg-normal.trae.ai/api/ide/v1/text_to_image?prompt=Bumper%20cars%20arena%20colorful%20amusement%20park%20ride%20for%20kids%20and%20family%20fun&image_size=landscape_16_9",
    "https://coresg-normal.trae.ai/api/ide/v1/text_to_image?prompt=Mine%20of%20elves%20fairy%20tale%20house%20miniature%20village%20children%20theme%20area%20magical%20forest&image_size=landscape_16_9",
    "https://coresg-normal.trae.ai/api/ide/v1/text_to_image?prompt=Pterodactyl%20flying%20simulator%20swinging%20roller%20coaster%20ride%20amusement%20park%20thrill%20attraction&image_size=landscape_16_9",
    "https://coresg-normal.trae.ai/api/ide/v1/text_to_image?prompt=Dinosaur%20teeth%20themed%20kids%20playground%20colorful%20attraction%20children%20fun%20area%20Florybal%20park&image_size=landscape_16_9",
    "https://coresg-normal.trae.ai/api/ide/v1/text_to_image?prompt=Django%20Gan%20African%20themed%20area%20traditional%20huts%20village%20decoration%20cultural%20exhibit%20park&image_size=landscape_16_9",
    "https://coresg-normal.trae.ai/api/ide/v1/text_to_image?prompt=Fossil%20excavation%20dig%20site%20children%20educational%20paleontology%20attraction%20dinosaur%20bones%20exhibit&image_size=landscape_16_9",
    "https://coresg-normal.trae.ai/api/ide/v1/text_to_image?prompt=Native%20Brazilian%20indigenous%20themed%20village%20hut%20traditional%20culture%20exhibit%20Florybal%20park%20attraction&image_size=landscape_16_9",
    "https://coresg-normal.trae.ai/api/ide/v1/text_to_image?prompt=Gold%20mine%20themed%20adventure%20attraction%20wooden%20railway%20cart%20tunnel%20entrance%20family%20park&image_size=landscape_16_9",
    "https://coresg-normal.trae.ai/api/ide/v1/text_to_image?prompt=Magic%20cave%20misterio%20interior%20mystical%20fantasy%20decorations%20mysterious%20lights%20crystals%20Brazil%20tour&image_size=landscape_16_9"
  ],
  tags: ["Dinossauros realistas e sonoros", "Cachoeiras e natureza preservada", "Trilhas mágicas e temáticas"]
};

const whatsappMessage = `Olá! Gostaria de mais informações sobre o ${passeio.titulo} - ${passeio.subtitulo}.`;
const whatsappUrl = `https://wa.me/5554992460547?text=${encodeURIComponent(whatsappMessage)}`;
---

<BaseLayout 
  title={`${passeio.titulo} - ${passeio.subtitulo} | Serra Transfer - Gramado RS`}
  description="Ingresso para o Parque Terra Mágica Florybal! Aventure-se com dinossauros animatrônicos, cachoeiras naturais e trilhas mágicas com a Serra Transfer!"
  keywords={['Terra Mágica Florybal', 'ingresso Terra Mágica', 'parque dinossauros RS', 'trilhas mágicas Gramado', 'Serra Transfer']}
  image={passeio.galeria[0]}
>
  <Header />
  
  <main class="pt-20 lg:pt-24">
    <!-- Hero Section -->
    <section class="relative h-96 lg:h-[500px] overflow-hidden" style={`background-image: url('${passeio.galeria[0]}'); background-attachment: fixed; background-size: cover; background-position: center; background-repeat: no-repeat;`}>
      <div class="absolute inset-0 bg-black/40"></div>
      <div class="absolute inset-0 flex items-center justify-center">
        <div class="text-center text-white px-4">
          <span class="inline-block bg-primary-600 text-white px-3 py-1 rounded-full text-sm font-medium mb-4">
            {passeio.categoria}
          </span>
          <h1 class="text-4xl lg:text-6xl font-bold mb-4">{passeio.titulo}</h1>
          <p class="text-xl lg:text-2xl opacity-90">{passeio.subtitulo}</p>
        </div>
      </div>
    </section>

    <div class="container mx-auto px-4 py-12">
      <div class="grid lg:grid-cols-3 gap-8">
        <!-- Conteúdo Principal -->
        <div class="lg:col-span-3">

          <!-- Descrição -->
          <div class="mb-8">
            <h2 class="text-2xl font-bold mb-4">Sobre esta atração</h2>
            <p class="text-gray-700 leading-relaxed">{passeio.descricao}</p>
          </div>

          <!-- O que está incluso -->
          <div class="mb-8">
            <h3 class="text-xl font-bold mb-4">O que está incluso</h3>
            <ul class="space-y-2">
              {passeio.inclusos.map(item => (
                <li class="flex items-center space-x-3">
                  <svg class="w-5 h-5 text-green-500" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                  </svg>
                  <span class="text-gray-700">{item}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- O que NÃO está incluso -->
          <div class="mb-8">
            <h3 class="text-xl font-bold mb-4">O que NÃO está incluso</h3>
            <ul class="space-y-2">
              <li class="flex items-center space-x-3">
                <svg class="w-5 h-5 text-red-500" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"></path>
                </svg>
                <span class="text-gray-700">Voo do Pterodáctilo</span>
              </li>
              <li class="flex items-center space-x-3">
                <svg class="w-5 h-5 text-red-500" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"></path>
                </svg>
                <span class="text-gray-700">Velociráptor</span>
              </li>
              <li class="flex items-center space-x-3">
                <svg class="w-5 h-5 text-red-500" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"></path>
                </svg>
                <span class="text-gray-700">Cinema 7D</span>
              </li>
              <li class="flex items-center space-x-3">
                <svg class="w-5 h-5 text-red-500" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"></path>
                </svg>
                <span class="text-gray-700">Alimentação</span>
              </li>
              <li class="flex items-center space-x-3">
                <svg class="w-5 h-5 text-red-500" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"></path>
                </svg>
                <span class="text-gray-700">Fotos Produzidas</span>
              </li>
            </ul>
          </div>

          <!-- Tags -->
          <div class="mb-8">
            <h3 class="text-xl font-bold mb-4">Destaques</h3>
            <div class="flex flex-wrap gap-2">
              {passeio.tags.map(tag => (
                <span class="bg-primary-100 text-primary-800 px-3 py-1 rounded-full text-sm font-medium">
                  {tag}
                </span>
              ))}
            </div>
          </div>

          <!-- Galeria de Imagens -->
          <div class="mb-8">
            <h3 class="text-xl font-bold mb-4">Galeria de Imagens</h3>
            <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
              {passeio.galeria.map((imagem, index) => (
                <div class="aspect-square overflow-hidden rounded-lg cursor-pointer hover:opacity-80 transition-opacity" onclick={`openModal(${index})`}>
                  <img 
                    src={imagem} 
                    alt={`${passeio.titulo} - Imagem ${index + 1}`}
                    class="w-full h-full object-cover"
                  />
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>

<!-- Modal para Galeria -->
<div id="imageModal" class="fixed inset-0 bg-black bg-opacity-75 z-50 hidden flex items-center justify-center p-4">
  <div class="relative max-w-4xl max-h-full">
    <button 
      onclick="closeModal()" 
      class="absolute top-4 right-4 text-white hover:text-gray-300 z-10"
    >
      <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
    <img id="modalImage" src="" alt="" class="max-w-full max-h-full object-contain" />
  </div>
</div>

<script>
  const galeria = [
    "https://coresg-normal.trae.ai/api/ide/v1/text_to_image?prompt=Magical%20family%20theme%20park%20entrance%20with%20giant%20realistic%20roaring%20dinosaur%20sculpture%20and%20lush%20green%20forest%2C%20Serra%20Gaucha%20Brazil%20tourist%20attraction&image_size=landscape_16_9",
    "https://coresg-normal.trae.ai/api/ide/v1/text_to_image?prompt=Tiger%20cavern%20theme%20cave%20interior%20magical%20kingdom%20Florybal%20park%20decoration%20mystical%20atmosphere&image_size=landscape_16_9",
    "https://coresg-normal.trae.ai/api/ide/v1/text_to_image?prompt=Outdoor%20theater%20facade%20with%20fantasy%20medieval%20style%20design%2C%20Florybal%20magical%20park%20dream%20theater&image_size=landscape_16_9",
    "https://coresg-normal.trae.ai/api/ide/v1/text_to_image?prompt=Kids%20riding%20dinosaur%20movable%20carousel%20ride%20with%20colorful%20decoration%20family%20amusement%20park&image_size=landscape_16_9",
    "https://coresg-normal.trae.ai/api/ide/v1/text_to_image?prompt=Chocolate%20factory%20interactive%20tour%20exhibit%2C%20sweet%20themed%20attraction%20for%20children%20delicious%20display&image_size=landscape_16_9",
    "https://coresg-normal.trae.ai/api/ide/v1/text_to_image?prompt=Cinema%207D%20motion%20theater%20building%20exterior%20family%20park%20immersive%20movie%20experience%20attraction&image_size=landscape_16_9",
    "https://coresg-normal.trae.ai/api/ide/v1/text_to_image?prompt=Aerobike%20sky%20bike%20ride%20cable%20rail%20amusement%20park%20attraction%20above%20trees%20adventure%20park&image_size=landscape_16_9",
    "https://coresg-normal.trae.ai/api/ide/v1/text_to_image?prompt=Bumper%20cars%20arena%20colorful%20amusement%20park%20ride%20for%20kids%20and%20family%20fun&image_size=landscape_16_9",
    "https://coresg-normal.trae.ai/api/ide/v1/text_to_image?prompt=Mine%20of%20elves%20fairy%20tale%20house%20miniature%20village%20children%20theme%20area%20magical%20forest&image_size=landscape_16_9",
    "https://coresg-normal.trae.ai/api/ide/v1/text_to_image?prompt=Pterodactyl%20flying%20simulator%20swinging%20roller%20coaster%20ride%20amusement%20park%20thrill%20attraction&image_size=landscape_16_9",
    "https://coresg-normal.trae.ai/api/ide/v1/text_to_image?prompt=Dinosaur%20teeth%20themed%20kids%20playground%20colorful%20attraction%20children%20fun%20area%20Florybal%20park&image_size=landscape_16_9",
    "https://coresg-normal.trae.ai/api/ide/v1/text_to_image?prompt=Django%20Gan%20African%20themed%20area%20traditional%20huts%20village%20decoration%20cultural%20exhibit%20park&image_size=landscape_16_9",
    "https://coresg-normal.trae.ai/api/ide/v1/text_to_image?prompt=Fossil%20excavation%20dig%20site%20children%20educational%20paleontology%20attraction%20dinosaur%20bones%20exhibit&image_size=landscape_16_9",
    "https://coresg-normal.trae.ai/api/ide/v1/text_to_image?prompt=Native%20Brazilian%20indigenous%20themed%20village%20hut%20traditional%20culture%20exhibit%20Florybal%20park%20attraction&image_size=landscape_16_9",
    "https://coresg-normal.trae.ai/api/ide/v1/text_to_image?prompt=Gold%20mine%20themed%20adventure%20attraction%20wooden%20railway%20cart%20tunnel%20entrance%20family%20park&image_size=landscape_16_9",
    "https://coresg-normal.trae.ai/api/ide/v1/text_to_image?prompt=Magic%20cave%20misterio%20interior%20mystical%20fantasy%20decorations%20mysterious%20lights%20crystals%20Brazil%20tour&image_size=landscape_16_9"
  ];
  
  function openModal(index) {
    const modal = document.getElementById('imageModal');
    const modalImage = document.getElementById('modalImage');
    modalImage.src = galeria[index];
    modalImage.alt = `Parque Terra Mágica Florybal - Imagem ${index + 1}`;
    modal.classList.remove('hidden');
  }
  
  function closeModal() {
    const modal = document.getElementById('imageModal');
    modal.classList.add('hidden');
  }
  
  // Fechar modal ao clicar fora da imagem
  document.getElementById('imageModal').addEventListener('click', function(e) {
    if (e.target === this) {
      closeModal();
    }
  });
</script>