---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StarRating from '../components/StarRating.astro';

const passeio = {
  titulo: "Gatzz Fondue & Show",
  subtitulo: "Fondue Premium com Espetáculo de Broadway",
  categoria: "INGRESSOS E ATRAÇÕES",
  avaliacao: 4.8,
  totalAvaliacoes: 0,
  linkOficial: "https://www.gatzz.com.br?ac=X0GS9W27FL",
  descricao: "O Gatzz traz a sensação de um jantar na Broadway para a Serra Gaúcha. É um dinner show completo: sequência premium de fondue (queijo, carnes nobres e chocolates de Gramado) seguida por um espetáculo de alto nível com mais de 22 artistas: música ao vivo, dança, teatro, acrobacias e coreografias. Focado em adultos (18+), com classificação etária em alguns espetáculos. Artistas circulam no hall e posam para fotos após o show.",
  inclusos: [
    "Sequência Fondue de Queijos Premium com baguete, batatas, legumes, cogumelos e frutas secas",
    "Fondue de Carnes (Filé mignon, Frango e Cordeiro) com 12 molhos especiais",
    "Fondue de Chocolate com frutas da estação, brownies, cookies, marshmallows e minichurros",
    "Espetáculo completo após jantar",
    "Interação com artistas antes e depois do show",
    "Estacionamento no local"
  ],
  duracao: "Aproximadamente 3h (jantar + espetáculo)",
  horarios: ["Jantar: 18h30", "Espetáculo: 21h30"],
  endereco: "Av. das Hortênsias, 3380 — Avenida Central, Gramado/RS",
  galeria: [
    "https://coresg-normal.trae.ai/api/ide/v1/text_to_image?prompt=Elegant%20Broadway%20style%20dinner%20show%20theater%20restaurant%2C%20grand%20stage%20with%20spotlights%2C%20luxury%20tables%2C%20red%20velvet%20curtains%2C%20chandeliers%2C%20Gatzz%20Fondue%20Show%20Gramado&image_size=landscape_16_9",
    "https://coresg-normal.trae.ai/api/ide/v1/text_to_image?prompt=Premium%20gourmet%20fondue%20three%20course%20meal%2C%20cheese%20fondue%20pot%2C%20filet%20mignon%20chicken%20lamb%20meat%20fondue%2C%20Gramado%20chocolate%20fondue%20dessert%2C%2012%20special%20sauces%2C%20Gatzz&image_size=landscape_16_9",
    "https://coresg-normal.trae.ai/api/ide/v1/text_to_image?prompt=Broadway%20musical%20live%20performance%20stage%2C%2022%20artists%20dancers%20singers%20acrobats%20colorful%20costumes%2C%20dramatic%20theater%20lighting%2C%20choreography%2C%20Gatzz%20Show%20Gramado&image_size=landscape_16_9",
    "https://coresg-normal.trae.ai/api/ide/v1/text_to_image?prompt=Acrobat%20aerial%20silk%20performance%20dinner%20show%20theater%2C%20artist%20flying%20on%20stage%2C%20dramatic%20lighting%2C%20audience%20tables%20below%2C%20Broadway%20quality%20entertainment%2C%20Gatzz&image_size=landscape_16_9",
    "https://coresg-normal.trae.ai/api/ide/v1/text_to_image?prompt=Cast%20of%2022%20Broadway%20artists%20taking%20final%20bow%20on%20stage%2C%20colorful%20costumes%2C%20standing%20ovation%2C%20curtain%20call%2C%20dinner%20show%20theater%2C%20Gatzz%20Fondue%20%26%20Show%20Gramado&image_size=landscape_16_9",
    "https://coresg-normal.trae.ai/api/ide/v1/text_to_image?prompt=Elegant%20adults%20only%20dinner%20table%20with%20couple%20enjoying%20chocolate%20fondue%20dessert%2C%20romantic%20ambient%20lighting%2C%20wine%20glasses%2C%20Broadway%20show%20background%2C%20Gatzz%2018%2B%20experience&image_size=landscape_16_9"
  ],
  tags: [
    "Dinner show",
    "Fondue premium",
    "Musical da Broadway",
    "Classificação 18+",
    "Mais de 22 artistas"
  ]
};

const whatsappMessage = `Olá! Gostaria de mais informações sobre o ${passeio.titulo} - ${passeio.subtitulo}.`;
const whatsappUrl = `https://wa.me/5554993220552?text=${encodeURIComponent(whatsappMessage)}`;
---

<BaseLayout 
  title={`${passeio.titulo} - Ingresso | Serra Transfer - Gramado RS`}
  description="Ingresso para Gatzz Fondue & Show! Dinner show com fondue premium e espetáculo estilo Broadway com mais de 22 artistas em Gramado/RS."
  keywords={['Gatzz Fondue Show', 'ingresso Gatzz', 'dinner show Gramado', 'fondue premium Gramado', 'musical Broadway Gramado', 'Serra Transfer']}
  image={passeio.galeria[0]}
>
  <Header />
  
  <main class="pt-20 lg:pt-24">
    <!-- Hero Section -->
    <section class="relative h-96 lg:h-[500px] overflow-hidden" style={`background-image: url('${passeio.galeria[0]}'); background-attachment: fixed; background-size: cover; background-position: center; background-repeat: no-repeat;`}>
      <div class="absolute inset-0 bg-black/40"></div>
      <div class="absolute inset-0 flex items-center justify-center">
        <div class="text-center text-white px-4">
          <span class="inline-block px-3 py-1 bg-primary-600 text-white text-sm font-medium rounded-full mb-4">
            {passeio.categoria}
          </span>
          <h1 class="text-4xl lg:text-6xl font-bold mb-4">{passeio.titulo}</h1>
          <p class="text-xl lg:text-2xl text-gray-200">{passeio.subtitulo}</p>
        </div>
      </div>
    </section>

    <div class="container mx-auto px-4 py-12">
      <div class="grid lg:grid-cols-3 gap-12">
        <!-- Conteúdo Principal -->
        <div class="lg:col-span-3">

          <!-- Descrição -->
          <div class="mb-8">
            <h2 class="text-2xl font-bold mb-4">Sobre esta atração</h2>
            <p class="text-gray-700 leading-relaxed">{passeio.descricao}</p>
          </div>

          <!-- O que está incluso -->
          <div class="mb-8">
            <h3 class="text-xl font-bold mb-4">O que está incluso</h3>
            <ul class="space-y-2">
              {passeio.inclusos.map(item => (
                <li class="flex items-center space-x-3">
                  <svg class="w-5 h-5 text-green-500" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                  </svg>
                  <span class="text-gray-700">{item}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Duração e Horários -->
          <div class="mb-8 grid md:grid-cols-2 gap-6">
            <div class="bg-gray-50 p-6 rounded-lg">
              <h3 class="text-xl font-bold mb-3">Duração</h3>
              <p class="text-gray-700">{passeio.duracao}</p>
            </div>
            <div class="bg-gray-50 p-6 rounded-lg">
              <h3 class="text-xl font-bold mb-3">Horários</h3>
              <ul class="space-y-1">
                {passeio.horarios.map(horario => (
                  <li class="text-gray-700">🕐 {horario}</li>
                ))}
              </ul>
            </div>
          </div>

          <!-- Tags -->
          <div class="mb-8">
            <h3 class="text-xl font-bold mb-4">Destaques</h3>
            <div class="flex flex-wrap gap-2">
              {passeio.tags.map(tag => (
                <span class="px-3 py-1 bg-primary-100 text-primary-700 rounded-full text-sm">
                  {tag}
                </span>
              ))}
            </div>
          </div>

          <!-- Botões CTA -->
          <div class="mb-8">
            <div class="grid md:grid-cols-2 gap-4">
              <a 
                href={passeio.linkOficial} 
                target="_blank" 
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center px-8 py-4 bg-red-600 hover:bg-red-700 text-white font-bold text-lg rounded-lg shadow-lg transition-all hover:shadow-xl transform hover:-translate-y-0.5"
              >
                🎟️ Comprar ingresso oficial
              </a>
              <a 
                href={whatsappUrl} 
                target="_blank" 
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center px-8 py-4 bg-green-600 hover:bg-green-700 text-white font-bold text-lg rounded-lg shadow-lg transition-all hover:shadow-xl transform hover:-translate-y-0.5"
              >
                💬 Falar com atendente no WhatsApp
              </a>
            </div>
          </div>

          <!-- Endereço -->
          <div class="mb-8">
            <h3 class="text-xl font-bold mb-4">Localização</h3>
            <div class="bg-gray-50 p-6 rounded-lg flex items-start space-x-4">
              <div class="flex-shrink-0">
                <svg class="w-8 h-8 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                </svg>
              </div>
              <div>
                <h4 class="font-bold text-gray-800">Endereço</h4>
                <p class="text-gray-700">{passeio.endereco}</p>
              </div>
            </div>
          </div>

          <!-- Galeria de Imagens -->
          <div class="mb-8">
            <h3 class="text-xl font-bold mb-4">Galeria</h3>
            <div class="grid grid-cols-2 lg:grid-cols-3 gap-4">
              {passeio.galeria.map((imagem, index) => (
                <div class="aspect-square overflow-hidden rounded-lg cursor-pointer hover:opacity-80 transition-opacity">
                  <img 
                    src={imagem} 
                    alt={`${passeio.titulo} - Imagem ${index + 1}`}
                    class="w-full h-full object-cover"
                    onclick={`openModal('${imagem}')`}
                  />
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <!-- Modal para Galeria -->
  <div id="imageModal" class="fixed inset-0 bg-black/80 z-50 hidden items-center justify-center p-4">
    <div class="relative max-w-4xl max-h-full">
      <button 
        onclick="closeModal()"
        class="absolute -top-10 right-0 text-white hover:text-gray-300 text-2xl"
      >
        ✕
      </button>
      <img id="modalImage" src="" alt="" class="max-w-full max-h-full object-contain rounded-lg" />
    </div>
  </div>

  <Footer />
</BaseLayout>

<script>
  function openModal(imageSrc) {
    const modal = document.getElementById('imageModal');
    const modalImage = document.getElementById('modalImage');
    modalImage.src = imageSrc;
    modal.classList.remove('hidden');
    modal.classList.add('flex');
  }

  function closeModal() {
    const modal = document.getElementById('imageModal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
  }

  document.getElementById('imageModal').addEventListener('click', function(e) {
    if (e.target === this) {
      closeModal();
    }
  });
</script>
