---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StarRating from '../components/StarRating.astro';
import FormReserva from '../components/FormReserva.astro';

const passeio = {
  titulo: "Mini Mundo",
  subtitulo: "Ingresso",
  categoria: "INGRESSOS E ATRAÇÕES",
  preco: 58.00,
  avaliacao: 4.80,
  totalAvaliacoes: 8,
  descricao: "O Mini Mundo é um parque ao ar livre, formado por réplicas fiéis de obras brasileiras e internacionais. As construções são ricas em detalhes e únicas. Juntas elas compõem nossa cidade 24 vezes menor que o mundo real, animada por milhares de pequenos moradores com suas vidas agitadas.",
  inclusos: [
    "Ingresso para o parque",
    "Acesso a todas as réplicas em miniatura",
    "Visita guiada (opcional)",
    "Área de lazer"
  ],
  duracao: "2 horas",
  horarios: ["09:00", "10:00", "11:00", "13:00", "14:00", "15:00", "16:00"],
  galeria: [
    "/images/Mini-Mundo/minimundo.png",
    "/images/Mini-Mundo/minimundo01.png",
    "/images/Mini-Mundo/minimundo02.png",
    "/images/Mini-Mundo/minimundo03.png"
  ],
  tags: ["Cidade em miniatura", "Réplicas fiéis de obras brasileiras", "Parque ao ar livre"]
};

const whatsappMessage = `Olá! Gostaria de mais informações sobre o ${passeio.titulo} - ${passeio.subtitulo}. Valor: R$ ${passeio.preco.toFixed(2).replace('.', ',')}.`;
const whatsappUrl = `https://wa.me/5554993220552?text=${encodeURIComponent(whatsappMessage)}`;
---

<BaseLayout 
  title={`${passeio.titulo} - Ingresso | Serra Transfer - Gramado RS`}
  description="Ingresso para o Mini Mundo em Gramado! Explore a cidade em miniatura com réplicas fiéis de obras brasileiras e internacionais com a Serra Transfer!"
  keywords={['Mini Mundo Gramado', 'ingresso Mini Mundo', 'cidade em miniatura RS', 'parque temático Gramado', 'Serra Transfer']}
  image={passeio.galeria[0]}
>
  <Header />
  
  <main class="pt-20 lg:pt-24">
    <!-- Hero Section -->
    <section class="relative h-96 lg:h-[500px] overflow-hidden" style={`background-image: url('${passeio.galeria[0]}'); background-attachment: fixed; background-size: cover; background-position: center; background-repeat: no-repeat;`}>
      <div class="absolute inset-0 bg-black/40"></div>
      <div class="absolute inset-0 flex items-center justify-center">
        <div class="text-center text-white px-4">
          <span class="inline-block bg-primary-600 text-white px-3 py-1 rounded-full text-sm font-medium mb-4">
            {passeio.categoria}
          </span>
          <h1 class="text-4xl lg:text-6xl font-bold mb-4">{passeio.titulo}</h1>
          <p class="text-xl lg:text-2xl opacity-90">{passeio.subtitulo}</p>
        </div>
      </div>
    </section>

    <div class="container mx-auto px-4 py-12">
      <div class="grid lg:grid-cols-3 gap-8">
        <!-- Conteúdo Principal -->
        <div class="lg:col-span-2">
          <!-- Avaliações e Preço -->
          <div class="flex flex-wrap items-center justify-between mb-8 p-6 bg-gray-50 rounded-xl">
            <div class="flex flex-col mb-4 lg:mb-0">
              <p class="text-gray-700 font-medium mb-1"><strong>Nossos Clientes Recomendam:</strong></p>
              <div class="flex items-center space-x-4">
                <StarRating rating={passeio.avaliacao} />
                <span class="text-gray-600">({passeio.totalAvaliacoes} avaliações)</span>
              </div>
            </div>
            <div class="text-right">
              <div class="text-gray-500 text-sm mb-1">A partir de:</div>
              <div class="text-3xl font-bold text-primary-600">R$ {passeio.preco.toFixed(2).replace('.', ',')}</div>
            </div>
          </div>

          <!-- Descrição -->
          <div class="mb-8">
            <h2 class="text-2xl font-bold mb-4">Sobre esta atração</h2>
            <p class="text-gray-700 leading-relaxed">{passeio.descricao}</p>
          </div>

          <!-- Mini Mundo em números -->
          <div class="mb-8">
            <h3 class="text-xl font-bold mb-4">Mini Mundo em números</h3>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
              <div class="bg-gray-50 p-6 rounded-xl text-center">
                <p class="text-3xl font-bold text-primary-600 mb-2">5.370m²</p>
                <p class="text-gray-700">Área total do parque</p>
              </div>
              <div class="bg-gray-50 p-6 rounded-xl text-center">
                <p class="text-3xl font-bold text-primary-600 mb-2">2 horas</p>
                <p class="text-gray-700">Tempo médio de visitação</p>
              </div>
              <div class="bg-gray-50 p-6 rounded-xl text-center">
                <p class="text-3xl font-bold text-primary-600 mb-2">3.268</p>
                <p class="text-gray-700">Mini-habitantes no parque</p>
              </div>
            </div>
          </div>

          <!-- Uma cidade em miniatura -->
          <div class="mb-8">
            <h3 class="text-xl font-bold mb-4">Uma cidade em miniatura</h3>
            <p class="text-gray-700 leading-relaxed mb-4">O Mini Mundo é um parque ao ar livre aberto todos os dias das 09:00 às 17:00.</p>
            <p class="text-gray-700 leading-relaxed">As réplicas, expostas ao ar livre, são elaboradas pela oficina do próprio parque, resultado do pioneirismo em mais de 40 anos de desenvolvimento de técnicas construtivas. A escolha de cada nova construção é detalhadamente estudada e interpretada, para que traduza toda a sua importância dentro do contexto do cenário, contribuindo na composição desta verdadeira cidade em miniatura.</p>
          </div>

          <!-- O que está incluso -->
          <div class="mb-8">
            <h3 class="text-xl font-bold mb-4">O que está incluso</h3>
            <ul class="space-y-2">
              {passeio.inclusos.map(item => (
                <li class="flex items-center space-x-3">
                  <svg class="w-5 h-5 text-green-500" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                  </svg>
                  <span class="text-gray-700">{item}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- O que NÃO está incluso -->
          <div class="mb-8">
            <h3 class="text-xl font-bold mb-4">O que NÃO está incluso</h3>
            <ul class="space-y-2">
              <li class="flex items-center space-x-3">
                <svg class="w-5 h-5 text-red-500" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"></path>
                </svg>
                <span class="text-gray-700">Transporte</span>
              </li>
              <li class="flex items-center space-x-3">
                <svg class="w-5 h-5 text-red-500" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"></path>
                </svg>
                <span class="text-gray-700">Alimentação</span>
              </li>
              <li class="flex items-center space-x-3">
                <svg class="w-5 h-5 text-red-500" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"></path>
                </svg>
                <span class="text-gray-700">Fotos profissionais</span>
              </li>
            </ul>
          </div>

          <!-- Tags -->
          <div class="mb-8">
            <h3 class="text-xl font-bold mb-4">Destaques</h3>
            <div class="flex flex-wrap gap-2">
              {passeio.tags.map(tag => (
                <span class="bg-primary-100 text-primary-800 px-3 py-1 rounded-full text-sm font-medium">
                  {tag}
                </span>
              ))}
            </div>
          </div>

          <!-- Galeria de Imagens -->
          <div class="mb-8">
            <h3 class="text-xl font-bold mb-4">Galeria de Imagens</h3>
            <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
              {passeio.galeria.map((imagem, index) => (
                <div class="aspect-square overflow-hidden rounded-lg cursor-pointer hover:opacity-80 transition-opacity" onclick={`openModal(${index})`}>
                  <img 
                    src={imagem} 
                    alt={`${passeio.titulo} - Imagem ${index + 1}`}
                    class="w-full h-full object-cover"
                  />
                </div>
              ))}
            </div>
          </div>
        </div>

        <!-- Sidebar de Reserva -->
        <div class="lg:col-span-1">
          <div class="bg-white rounded-xl shadow-lg p-6 sticky top-24">
<a 
              href="https://loja.minimundo.com.br/?bookingagency=21454&ingToken=vendaParceiros"
              target="_blank"
              class="w-full bg-primary-600 hover:bg-primary-700 text-white font-bold py-4 px-6 rounded-lg transition-colors flex items-center justify-center space-x-2 mb-4"
            >
              <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
              </svg>
              <span class="text-center">Compre pelo Site Oficial</span>
            </a>

              <FormReserva
                passeioNome={passeio.titulo}
                passeioPreco={passeio.preco}
                passeioDuracao={passeio.duracao}
                passeioHorarios={passeio.horarios}
                passeioCategoria={passeio.categoria}
              />
            </div>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>

<!-- Modal para Galeria -->
<div id="imageModal" class="fixed inset-0 bg-black bg-opacity-75 z-50 hidden flex items-center justify-center p-4">
  <div class="relative max-w-4xl max-h-full">
    <button 
      onclick="closeModal()" 
      class="absolute top-4 right-4 text-white hover:text-gray-300 z-10"
    >
      <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
    <img id="modalImage" src="" alt="" class="max-w-full max-h-full object-contain" />
  </div>
</div>

<script>
  const galeria = [
    "/images/Mini-Mundo/minimundo.png",
    "/images/Mini-Mundo/minimundo01.png",
    "/images/Mini-Mundo/minimundo02.png",
    "/images/Mini-Mundo/minimundo03.png"
  ];
  
  function openModal(index) {
    const modal = document.getElementById('imageModal');
    const modalImage = document.getElementById('modalImage');
    modalImage.src = galeria[index];
    modalImage.alt = `Mini Mundo - Imagem ${index + 1}`;
    modal.classList.remove('hidden');
  }
  
  function closeModal() {
    const modal = document.getElementById('imageModal');
    modal.classList.add('hidden');
  }
  
  // Fechar modal ao clicar fora da imagem
  document.getElementById('imageModal').addEventListener('click', function(e) {
    if (e.target === this) {
      closeModal();
    }
  });
</script>