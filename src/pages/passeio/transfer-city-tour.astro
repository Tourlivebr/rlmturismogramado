---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FormReserva from '../../components/FormReserva.astro';
import { promocaoOutubro as promocao } from '../../data/promocaoOutubro';
---

<BaseLayout title={`${promocao.titulo} | Promoção de outubro | RLM Turismo Gramado`} description={promocao.descricao[0]} image={promocao.imagem}>
  <Header />
  <main class="pt-24 lg:pt-32 pb-16 bg-gray-50 dark:bg-gray-900">
    <div class="container mx-auto px-4">
      <a href="/passeios" class="inline-block mb-6 text-primary-600 dark:text-primary-400 hover:underline">← Voltar aos passeios</a>
      <span class="block text-sm font-semibold text-primary-600 dark:text-primary-400 mb-2">Promoção de outubro · Reserva antecipada</span>
      <h1 class="text-3xl lg:text-5xl font-bold text-gray-900 dark:text-white mb-8">{promocao.titulo}</h1>
      <div class="grid lg:grid-cols-3 gap-8 items-start">
        <div class="lg:col-span-2 space-y-8">
          <img src={promocao.imagem} alt="Promoção de outubro: transfer aeroporto ida e volta + city tour em carro de 7 lugares" width="1254" height="1254" class="w-full h-auto rounded-2xl shadow-lg" />
          <section class="bg-white dark:bg-gray-800 rounded-2xl p-6 lg:p-8 shadow-sm">
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">Sobre este passeio</h2>
            {promocao.descricao.map(texto => <p class="text-gray-700 dark:text-gray-300 leading-relaxed mb-4">{texto}</p>)}
          </section>
        </div>
        <aside class="bg-white dark:bg-gray-800 rounded-2xl p-6 shadow-lg lg:sticky lg:top-28">
          <div class="bg-primary-50 dark:bg-primary-900/30 rounded-xl p-4 text-center mb-6">
            <p class="text-sm text-gray-500 dark:text-gray-400">De <del>R$ 1.599,00</del> por apenas</p>
            <p class="text-3xl font-extrabold text-primary-600 dark:text-primary-400">R$ 1.299,00</p>
          </div>
          <FormReserva passeioNome={promocao.titulo} passeioDuracao="A consultar" passeioCategoria="Promoção de outubro" />
          <a href={promocao.whatsappUrl} target="_blank" rel="noopener noreferrer" class="mt-4 block w-full border-2 border-green-500 hover:bg-green-50 dark:hover:bg-green-900/20 text-green-600 dark:text-green-400 font-semibold py-3 px-4 rounded-xl text-center">Fale no WhatsApp</a>
        </aside>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
