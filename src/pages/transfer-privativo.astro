---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StarRating from '../components/StarRating.astro';

const passeio = {
  titulo: "Transfer Ida e Volta • Porto Alegre / Gramado ou Canela",
  subtitulo: "Transporte privativo executivo",
  categoria: "RECEPTIVO",
  price1: 280.00,
  label1: "1 trecho (só ida ou só volta)",
  price2: 550.00,
  label2: "Ida e Volta",
  avaliacao: 4.95,
  totalAvaliacoes: 127,
  parcelas: "A partir de:",
  descricao: "Aproveite seu tempo com a comodidade do transporte privativo! Aprecie as lindas paisagens e colha ótimas dicas com o nosso motorista/guia sobre as programações e atrações da Serra Gaúcha. Sem espera no embarque/desembarque, com embarque imediato e desembarque na hora do seu voo. Privacidade total - só você e suas companhias no veículo. Realizamos translado de ida e volta entre o Aeroporto de Porto Alegre (ou qualquer ponto da capital) e as cidades de Gramado ou Canela.",
  inclusos: [
    "Transfer do Aeroporto de Porto Alegre para Gramado ou Canela",
    "Transfer de Gramado ou Canela para Aeroporto de Porto Alegre",
    "Motorista/guia experiente",
    "Veículo privativo e confortável com ar condicionado",
    "Dicas sobre atrações da Serra Gaúcha",
    "Água mineral disponível no veículo"
  ],
  naoInclusos: [],
  duracao: "Aproximadamente 2 horas cada trecho",
  horarios: ["Conforme horário do voo"],
  galeria: [
    "/images/Transfer/Transfer.jpg",
    "/images/transfer11.jpg",
    "/images/Transfer/Transfer.jpg",
    "/images/transfer11.jpg"
  ],
  tags: [
    "Sem espera no embarque/desembarque",
    "Embarque imediato",
    "Privacidade total",
    "Motorista / Guia experiente"
  ]
};

const whatsappAgencia = "5554993220552";
const whatsappMessage = `Olá! Gostaria de mais informações sobre o ${passeio.titulo}. Valor 1 trecho R$ ${passeio.price1.toFixed(2).replace('.', ',')} / Ida e Volta R$ ${passeio.price2.toFixed(2).replace('.', ',')}.`;
const whatsappUrl = `https://wa.me/${whatsappAgencia}?text=${encodeURIComponent(whatsappMessage)}`;
---

<BaseLayout
  title={`${passeio.titulo} | RLM Turismo Gramado - Gramado RS`}
  description="Translado privativo executivo entre o Aeroporto de Porto Alegre (POA) e Gramado ou Canela! Conforto total, motorista/guia experiente, horários flexíveis, embarque imediato e privacidade total com a RLM Turismo Gramado."
  keywords={['translado Gramado Porto Alegre', 'transfer POA Gramado', 'transfer ida e volta Gramado', 'transporte executivo POA Canela', 'transfer privativo Gramado', 'RLM Turismo Gramado']}
  image={passeio.galeria[0]}
>
  <Header />

  <main class="pt-20 lg:pt-24">
    <!-- Hero Section -->
    <section class="relative h-96 lg:h-[500px] overflow-hidden" style={`background-image: url('${passeio.galeria[0]}'); background-size: cover; background-position: center; background-repeat: no-repeat;`}>
      <div class="absolute inset-0 bg-black/40"></div>
      <div class="absolute inset-0 flex items-center justify-center">
        <div class="text-center text-white px-4 max-w-5xl mx-auto">
          <span class="inline-block px-4 py-1.5 bg-primary-600 text-white text-sm font-semibold rounded-full mb-4 tracking-wide">
            {passeio.categoria}
          </span>
          <h1 class="text-3xl sm:text-4xl lg:text-6xl font-bold mb-4 leading-tight">{passeio.titulo}</h1>
          <p class="text-lg lg:text-2xl text-gray-200 mb-5">{passeio.subtitulo}</p>
          <div class="flex flex-wrap items-center justify-center gap-3">
            <div class="flex items-center gap-1.5">
              <StarRating rating={passeio.avaliacao} />
              <span class="text-sm font-semibold text-white/90">{passeio.avaliacao.toFixed(2)}</span>
              <span class="text-xs text-white/70">({passeio.totalAvaliacoes})</span>
            </div>
            <span class="text-white/60 hidden sm:block">•</span>
            <span class="text-sm text-white/90 flex items-center gap-1.5">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
              {passeio.duracao}
            </span>
          </div>
        </div>
      </div>
    </section>

    <div class="container mx-auto px-4 py-12">
      <div class="grid lg:grid-cols-3 gap-12">
        <!-- Conteúdo Principal -->
        <div class="lg:col-span-2 space-y-10">

          <!-- Sobre este passeio -->
          <div class="bg-white rounded-2xl border border-gray-200 dark:border-gray-700/60 p-6 lg:p-8 shadow-sm">
            <h2 class="text-2xl font-bold mb-4 flex items-center gap-2.5">
              <span class="inline-flex items-center justify-center w-8 h-8 rounded-lg bg-primary-100 text-primary-700 dark:bg-primary-900/40 dark:text-primary-300">
                📖
              </span>
              Sobre este passeio
            </h2>
            <p class="text-gray-700 dark:text-gray-300 leading-relaxed text-[15px] mb-6">{passeio.descricao}</p>

            <div class="grid md:grid-cols-2 gap-5">
              <div class="bg-blue-50 dark:bg-blue-900/20 p-5 rounded-xl border border-blue-100 dark:border-blue-800/50">
                <h4 class="font-bold text-blue-800 dark:text-blue-300 mb-3 flex items-center gap-2">
                  <span>✈️</span> Transfer IN (Aeroporto → Gramado / Canela)
                </h4>
                <ul class="text-sm text-blue-700 dark:text-blue-200 space-y-1.5">
                  <li>• Motorista aguarda com placa identificada</li>
                  <li>• Saída imediata após desembarque</li>
                  <li>• Duração: aproximadamente 2h</li>
                  <li>• Deixamos no hotel / pousada informado</li>
                </ul>
              </div>

              <div class="bg-green-50 dark:bg-green-900/20 p-5 rounded-xl border border-green-100 dark:border-green-800/50">
                <h4 class="font-bold text-green-800 dark:text-green-300 mb-3 flex items-center gap-2">
                  <span>🏨</span> Transfer OUT (Gramado / Canela → Aeroporto)
                </h4>
                <ul class="text-sm text-green-700 dark:text-green-200 space-y-1.5">
                  <li>• Saída 4h a 5h antes do horário do voo</li>
                  <li>• Duração: aproximadamente 2h</li>
                  <li>• Busca no hotel / pousada</li>
                  <li>• Chegada pontual ao aeroporto</li>
                </ul>
              </div>
            </div>
          </div>

          <!-- O que está incluso -->
          {passeio.inclusos.length > 0 && (
            <div class="bg-white rounded-2xl border border-gray-200 dark:border-gray-700/60 p-6 lg:p-8 shadow-sm">
              <h3 class="text-xl font-bold mb-5 flex items-center gap-2.5">
                <span class="inline-flex items-center justify-center w-8 h-8 rounded-lg bg-green-100 text-green-700 dark:bg-green-900/40 dark:text-green-300">
                  ✅
                </span>
                O que está incluso
              </h3>
              <ul class="grid sm:grid-cols-2 gap-3">
                {passeio.inclusos.map(item => (
                  <li class="flex items-start gap-3 p-3 rounded-lg bg-gray-50 dark:bg-gray-800/60 border border-gray-100 dark:border-gray-700/50">
                    <svg class="w-5 h-5 text-green-500 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                    </svg>
                    <span class="text-gray-700 dark:text-gray-300 text-sm">{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}

          <!-- Destaques -->
          <div class="bg-white rounded-2xl border border-gray-200 dark:border-gray-700/60 p-6 lg:p-8 shadow-sm">
            <h3 class="text-xl font-bold mb-5 flex items-center gap-2.5">
              <span class="inline-flex items-center justify-center w-8 h-8 rounded-lg bg-primary-100 text-primary-700 dark:bg-primary-900/40 dark:text-primary-300">
                ⭐
              </span>
              Destaques
            </h3>
            <div class="flex flex-wrap gap-2">
              {passeio.tags.map(tag => (
                <span class="px-4 py-2 bg-primary-50 dark:bg-primary-900/20 text-primary-700 dark:text-primary-300 rounded-full text-sm font-medium border border-primary-100 dark:border-primary-800/40">{tag}</span>
              ))}
            </div>
          </div>

          <!-- Tabela de Preços -->
          <div class="bg-white rounded-2xl border border-gray-200 dark:border-gray-700/60 p-6 lg:p-8 shadow-sm">
            <h3 class="text-xl font-bold mb-5 flex items-center gap-2.5">
              <span class="inline-flex items-center justify-center w-8 h-8 rounded-lg bg-yellow-100 text-yellow-700 dark:bg-yellow-900/40 dark:text-yellow-300">
                💰
              </span>
              Valores
            </h3>
            <div class="grid md:grid-cols-2 gap-4">
              <div class="border-2 border-gray-200 dark:border-gray-700/60 rounded-xl p-5 text-center hover:border-primary-300 dark:hover:border-primary-700 transition">
                <p class="text-sm text-gray-500 dark:text-gray-400 font-semibold uppercase tracking-wide">{passeio.label1}</p>
                <p class="mt-2 text-3xl lg:text-4xl font-extrabold text-gray-800 dark:text-white">
                  R$ {passeio.price1.toFixed(2).replace('.', ',')}
                </p>
                <p class="mt-1 text-xs text-gray-400">por veículo · até 6 passageiros</p>
              </div>
              <div class="border-2 border-primary-300 dark:border-primary-600 bg-primary-50/50 dark:bg-primary-900/20 rounded-xl p-5 text-center relative overflow-hidden">
                <span class="absolute top-2 right-2 inline-block bg-primary-600 text-white text-[10px] font-bold px-2 py-0.5 rounded-full tracking-wider">MAIS ESCOLHIDO</span>
                <p class="text-sm text-primary-700 dark:text-primary-300 font-semibold uppercase tracking-wide">{passeio.label2}</p>
                <p class="mt-2 text-3xl lg:text-4xl font-extrabold text-primary-700 dark:text-primary-300">
                  R$ {passeio.price2.toFixed(2).replace('.', ',')}
                </p>
                <p class="mt-1 text-xs text-primary-600/70 dark:text-primary-400/80">por veículo · até 6 passageiros</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Sidebar: Formulario ESPECIFICO de Transfer (IDA / VOLTA / IDA+VOLTA) -->
        <div class="lg:col-span-1">
          <div id="sidebar-form-transfer" class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700/60 rounded-2xl p-6 lg:p-7 sticky top-24 shadow-lg max-h-[calc(100vh-7rem)] overflow-y-auto pr-5 scroll-smooth [scrollbar-gutter:stable]">

            <h3 class="text-xl font-extrabold text-gray-900 dark:text-white mb-1 flex items-center gap-2">
              📅 Solicitar Transfer
            </h3>
            <p class="text-sm text-gray-500 dark:text-gray-400 mb-5">
              Preencha os campos abaixo e envie direto para o WhatsApp da RLM.
            </p>

            <!-- TIPO: so ida / so volta / ida e volta -->
            <div class="mb-6">
              <label class="block text-sm font-bold text-gray-700 dark:text-gray-200 mb-2.5">
                Selecione o tipo de transfer <span class="text-red-500">*</span>
              </label>
              <div id="tipo-transfer-group" class="grid grid-cols-1 sm:grid-cols-3 gap-2 p-1 bg-gray-100 dark:bg-gray-900/60 rounded-xl">
                <button type="button" data-tipo-transfer="ida"
                  class="tipo-transfer-btn px-3 py-3 rounded-lg text-sm font-semibold transition-all duration-200 text-gray-600 dark:text-gray-400 hover:text-gray-900">
                  ✈️ Só IDA
                </button>
                <button type="button" data-tipo-transfer="volta"
                  class="tipo-transfer-btn px-3 py-3 rounded-lg text-sm font-semibold transition-all duration-200 text-gray-600 dark:text-gray-400 hover:text-gray-900">
                  🏨 Só VOLTA
                </button>
                <button type="button" data-tipo-transfer="ida-volta"
                  class="tipo-transfer-btn active bg-white dark:bg-gray-700 text-primary-700 dark:text-primary-300 shadow-sm px-3 py-3 rounded-lg text-sm font-bold transition-all duration-200 ring-2 ring-primary-500/30">
                  🔁 IDA &amp; VOLTA
                </button>
              </div>
            </div>

            <form id="form-transfer" onsubmit="return false;" class="space-y-4.5">

              <!-- ⚠️ DADOS GERAIS -->
              <div class="pt-3 border-t border-gray-100 dark:border-gray-700/60">
                <h4 class="text-xs font-black tracking-widest uppercase text-primary-700 dark:text-primary-400 mb-3">
                  📋 DADOS GERAIS
                </h4>

                <div class="space-y-3.5">
                  <div>
                    <label class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-1">Nome <span class="text-red-500">*</span></label>
                    <input type="text" id="tf_nome" value="GEZICA APARECIDA NUNES" required
                      class="w-full px-3.5 py-2.5 border border-gray-300 dark:border-gray-600 dark:bg-gray-900/60 dark:text-white rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none text-sm" placeholder="Nome completo">
                  </div>
                  <div class="grid grid-cols-2 gap-3">
                    <div>
                      <label class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-1">Passageiros <span class="text-red-500">*</span></label>
                      <input type="number" id="tf_passageiros" value="3" min="1" max="20" required
                        class="w-full px-3.5 py-2.5 border border-gray-300 dark:border-gray-600 dark:bg-gray-900/60 dark:text-white rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none text-sm">
                    </div>
                    <div>
                      <label class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-1">Telefone <span class="text-red-500">*</span></label>
                      <input type="tel" id="tf_telefone" value="(19) 19 97101-0990" required
                        class="w-full px-3.5 py-2.5 border border-gray-300 dark:border-gray-600 dark:bg-gray-900/60 dark:text-white rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none text-sm" placeholder="(00) 0 0000-0000">
                    </div>
                  </div>
                </div>
              </div>

              <!-- 🛬 DADOS DA IDA -->
              <div id="dados-ida" class="pt-3 border-t border-gray-100 dark:border-gray-700/60">
                <h4 class="text-xs font-black tracking-widest uppercase text-blue-700 dark:text-blue-400 mb-3">
                  🛬 DADOS DA IDA
                </h4>

                <div class="space-y-3.5">
                  <div class="grid grid-cols-2 gap-3">
                    <div>
                      <label class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-1">Data de chegada <span class="text-red-500">*</span></label>
                      <input type="text" id="tf_ida_data" value="12/09/2026" required
                        class="w-full px-3.5 py-2.5 border border-gray-300 dark:border-gray-600 dark:bg-gray-900/60 dark:text-white rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none text-sm" placeholder="dd/mm/aaaa">
                    </div>
                    <div>
                      <label class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-1">Horário <span class="text-red-500">*</span></label>
                      <input type="text" id="tf_ida_horario" value="08:00" required
                        class="w-full px-3.5 py-2.5 border border-gray-300 dark:border-gray-600 dark:bg-gray-900/60 dark:text-white rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none text-sm" placeholder="HH:MM">
                    </div>
                  </div>
                  <div>
                    <label class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-1">Número do voo <span class="text-red-500">*</span></label>
                    <input type="text" id="tf_ida_voo" value="AD 2603 - AZUL" required
                      class="w-full px-3.5 py-2.5 border border-gray-300 dark:border-gray-600 dark:bg-gray-900/60 dark:text-white rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none text-sm" placeholder="Ex.: AD 1234 - AZUL">
                  </div>
                  <div>
                    <label class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-1">Local de hospedagem <span class="text-red-500">*</span></label>
                    <input type="text" id="tf_ida_hotel" value="Hotel Laghetto Vivace" required
                      class="w-full px-3.5 py-2.5 border border-gray-300 dark:border-gray-600 dark:bg-gray-900/60 dark:text-white rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none text-sm" placeholder="Nome do hotel / pousada">
                    <textarea id="tf_ida_hotel_endereco" rows="2"
                      class="w-full mt-2 px-3.5 py-2 border border-gray-300 dark:border-gray-600 dark:bg-gray-900/60 dark:text-white rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none text-xs" placeholder="Endereço completo (opcional)">Av Julio De Castilhos, 602 - Centro, Canela - Rs, Rio Grande Do Sul, Brasil</textarea>
                  </div>
                </div>
              </div>

              <!-- 🛫 DADOS DA VOLTA -->
              <div id="dados-volta" class="pt-3 border-t border-gray-100 dark:border-gray-700/60">
                <h4 class="text-xs font-black tracking-widest uppercase text-green-700 dark:text-green-400 mb-3">
                  🛫 DADOS DA VOLTA
                </h4>

                <div class="space-y-3.5">
                  <div class="grid grid-cols-2 gap-3">
                    <div>
                      <label class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-1">Dia <span class="text-red-500">*</span></label>
                      <input type="text" id="tf_volta_dia" value="16/09/2026" required
                        class="w-full px-3.5 py-2.5 border border-gray-300 dark:border-gray-600 dark:bg-gray-900/60 dark:text-white rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none text-sm" placeholder="dd/mm/aaaa">
                    </div>
                    <div>
                      <label class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-1">Horário do voo <span class="text-red-500">*</span></label>
                      <input type="text" id="tf_volta_horario_voo" value="18:00" required
                        class="w-full px-3.5 py-2.5 border border-gray-300 dark:border-gray-600 dark:bg-gray-900/60 dark:text-white rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none text-sm" placeholder="HH:MM">
                    </div>
                  </div>
                  <div>
                    <label class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-1">Local de embarque</label>
                    <input type="text" id="tf_volta_hotel" value="Hotel Laghetto Vivace"
                      class="w-full px-3.5 py-2.5 border border-gray-300 dark:border-gray-600 dark:bg-gray-900/60 dark:text-white rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none text-sm" placeholder="Mesmo da ida? deixe igual">
                  </div>
                </div>
              </div>

              <!-- Observacoes -->
              <div class="pt-3 border-t border-gray-100 dark:border-gray-700/60">
                <label class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-1">Observações (opcional)</label>
                <textarea id="tf_obs" rows="3"
                  class="w-full px-3.5 py-2.5 border border-gray-300 dark:border-gray-600 dark:bg-gray-900/60 dark:text-white rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none text-sm" placeholder="Ex.: Tem bagagens grandes, criança de colo, parada extra, etc..."></textarea>
              </div>

              <!-- CTA WhatsApp -->
              <div class="pt-4">
                <button id="btn_enviar_whatsapp"
                  class="w-full inline-flex items-center justify-center gap-2.5 bg-green-500 hover:bg-green-600 text-white font-extrabold py-3.5 px-5 rounded-xl transition-all duration-200 shadow-lg shadow-green-500/25 text-base">
                  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M19.11 17.205c-.372 0-1.088 1.39-1.518 1.39a.63.63 0 01-.315-.1c-.802-.402-1.504-.817-2.163-1.447-.545-.516-1.146-1.29-1.46-1.963a.426.426 0 01-.073-.215c0-.33.99-.945.99-1.49 0-.143-.73-2.09-.832-2.335-.143-.372-.214-.487-.6-.487-.187 0-.36-.043-.53-.043-.302 0-.53.115-.746.315-.688.645-1.032 1.318-1.06 2.264v.114c-.015.99.472 1.977 1.017 2.78 1.23 1.82 2.506 3.41 4.554 4.34.616.287 2.035.888 2.722.888.817 0 2.15-.515 2.478-1.318.13-.33.243-.7.407-.999.058-.13.129-.258.237-.258a.63.63 0 01.228.043c.344.143 1.017.372 1.074.501.058.129.487 1.183.487 1.657 0 .516-.372.817-.86 1.115l-.101.057a2.077 2.077 0 01-.602.257z"/><path d="M12 2C6.477 2 2 6.477 2 12c0 1.893.525 3.66 1.439 5.182L2 22l4.893-1.415A9.958 9.958 0 0012 22c5.523 0 10-4.477 10-10S17.523 2 12 2z"/></svg>
                  ENVIAR PARA O WHATSAPP
                </button>

                <div class="mt-3 text-center text-[11px] text-gray-400 dark:text-gray-500 leading-tight">
                  <p>Ao clicar você será redirecionado para o WhatsApp</p>
                  <p>com todos os dados do seu transfer já preenchidos.</p>
                </div>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </main>

  <Footer />

  <script is:inline>
    (function () {
      const AGENCIA_WHATSAPP = "5554993220552";
      const TITULO_PASSEIO = "Transfer Ida e Volta • Porto Alegre / Gramado ou Canela";
      const PRECO_1 = "R$ 280,00";
      const PRECO_2 = "R$ 550,00";

      const $ = (id) => document.getElementById(id);

      const blocoIda = $("dados-ida");
      const blocoVolta = $("dados-volta");
      const botoesTipo = document.querySelectorAll(".tipo-transfer-btn");
      let tipoSelecionado = "ida-volta";

      function aplicarVisibilidade() {
        botoesTipo.forEach(b => {
          const isAtivo = b.dataset.tipoTransfer === tipoSelecionado;
          b.classList.toggle("active", isAtivo);
          b.classList.toggle("bg-white", isAtivo);
          b.classList.toggle("dark:bg-gray-700", isAtivo);
          b.classList.toggle("text-primary-700", isAtivo);
          b.classList.toggle("dark:text-primary-300", isAtivo);
          b.classList.toggle("shadow-sm", isAtivo);
          b.classList.toggle("ring-2", isAtivo);
          b.classList.toggle("ring-primary-500/30", isAtivo);
          b.classList.toggle("text-gray-600", !isAtivo);
          b.classList.toggle("dark:text-gray-400", !isAtivo);
        });

        if (tipoSelecionado === "ida") {
          blocoIda.style.display = "";
          blocoVolta.style.display = "none";
          blocoVolta.querySelectorAll("input, textarea").forEach(el => el.disabled = true);
          blocoIda.querySelectorAll("input, textarea").forEach(el => el.disabled = false);
        } else if (tipoSelecionado === "volta") {
          blocoIda.style.display = "none";
          blocoVolta.style.display = "";
          blocoIda.querySelectorAll("input, textarea").forEach(el => el.disabled = true);
          blocoVolta.querySelectorAll("input, textarea").forEach(el => el.disabled = false);
        } else {
          blocoIda.style.display = "";
          blocoVolta.style.display = "";
          blocoIda.querySelectorAll("input, textarea").forEach(el => el.disabled = false);
          blocoVolta.querySelectorAll("input, textarea").forEach(el => el.disabled = false);
        }
      }

      botoesTipo.forEach(b => {
        b.addEventListener("click", () => {
          tipoSelecionado = b.dataset.tipoTransfer;
          aplicarVisibilidade();
        });
      });

      aplicarVisibilidade();

      function v(id) {
        const el = $(id);
        return el ? (el.value || "").trim() : "";
      }

      function montarMensagem() {
        const nome = v("tf_nome") || "(não informado)";
        const qtd = v("tf_passageiros") || "(não informado)";
        const fone = v("tf_telefone") || "(não informado)";
        const obs = v("tf_obs");

        const tipoLabel =
          tipoSelecionado === "ida" ? "👉 SOMENTE IDA (Aeroporto → Hotel)"
          : tipoSelecionado === "volta" ? "👉 SOMENTE VOLTA (Hotel → Aeroporto)"
          : "👉 IDA E VOLTA (Aeroporto ↔ Hotel)";

        const valorEstimado =
          tipoSelecionado === "ida" || tipoSelecionado === "volta" ? PRECO_1 : PRECO_2;

        let msg = `*📅 Nova solicitação de Transfer*\n\n`;
        msg += `*Serviço:* ${TITULO_PASSEIO}\n`;
        msg += `${tipoLabel}\n`;
        msg += `*Valor estimado (por veículo):* ${valorEstimado}\n\n`;
        msg += `📋 *DADOS GERAIS*\n`;
        msg += `• Nome: ${nome}\n`;
        msg += `• Nº de passageiros: ${qtd}\n`;
        msg += `• Telefone: ${fone}\n`;

        if (tipoSelecionado !== "volta") {
          msg += `\n🛬 *DADOS DA IDA*\n`;
          msg += `• Data de chegada: ${v("tf_ida_data") || "(não informado)"}\n`;
          msg += `• Horário: ${v("tf_ida_horario") || "(não informado)"}\n`;
          msg += `• Número do voo: ${v("tf_ida_voo") || "(não informado)"}\n`;
          msg += `• Hospedagem: ${v("tf_ida_hotel") || "(não informado)"}\n`;
          const end = v("tf_ida_hotel_endereco");
          if (end) msg += `• Endereço: ${end}\n`;
        }

        if (tipoSelecionado !== "ida") {
          msg += `\n🛫 *DADOS DA VOLTA*\n`;
          msg += `• Dia: ${v("tf_volta_dia") || "(não informado)"}\n`;
          msg += `• Horário do voo: ${v("tf_volta_horario_voo") || "(não informado)"}\n`;
          const hotel = v("tf_volta_hotel");
          if (hotel) msg += `• Local de embarque: ${hotel}\n`;
        }

        if (obs) msg += `\n📝 *Observações:* ${obs}\n`;

        msg += `\nPor favor, confirmar disponibilidade e valor final 🙏`;
        return msg;
      }

      $("btn_enviar_whatsapp").addEventListener("click", () => {
        const texto = montarMensagem();
        const url = `https://wa.me/${AGENCIA_WHATSAPP}?text=${encodeURIComponent(texto)}`;
        window.open(url, "_blank", "noopener,noreferrer");
      });
    })();
  </script>
</BaseLayout>
