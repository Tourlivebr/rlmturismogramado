---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StarRating from '../components/StarRating.astro';

const passeio = {
  titulo: "ParksNet",
  subtitulo: "Passaporte para Parques e Atrações da Serra Gaúcha",
  categoria: "INGRESSOS E ATRAÇÕES",
  avaliacao: 4.7,
  totalAvaliacoes: 0,
  linkOficial: "https://parksnet.com.br/ingressos/?bookingAgency=326",
  descricao: "O ParksNet é o portal de ingressos oficial para as melhores atrações de Gramado e Canela, tudo em um só lugar! Compre antecipado Snowland (neve artificial), Acquamotion (parque aquático termal), NBA Park (primeiro parque da NBA no mundo), Space Adventure (parque NASA), Skyglass (plataforma de vidro no Vale da Ferradura), Bondinhos Aéreos do Caracol, Vila da Mônica, Mini Mundo, Jardim Secreto do Capitão, Alpen Park e muito mais. Pague em até 10x sem juros e receba seus ingressos no celular.",
  inclusos: [
    "Pague em até 10x sem juros",
    "Ingressos direto no WhatsApp ou e-mail",
    "Preços promocionais e cupons exclusivos",
    "Cancelamento garantido até 7 dias",
    "Atendimento suporte 24h"
  ],
  duracao: "Varia conforme atração escolhida",
  horarios: ["Consulte horários de cada atração"],
  endereco: "Online (ingressos digitais enviados por WhatsApp e e-mail)",
  galeria: [
    "https://coresg-normal.trae.ai/api/ide/v1/text_to_image?prompt=Collage%20montage%20multiple%20amusement%20parks%20attractions%20Gramado%20Canela%2C%20Snowland%20snow%20park%2C%20NBA%20Park%20basketball%2C%20Skyglass%20glass%20platform%2C%20Vila%20da%20Monica%2C%20Alpen%20Park%2C%20ParksNet%20Serra%20Gaucha%20Brazil&image_size=landscape_16_9",
    "https://coresg-normal.trae.ai/api/ide/v1/text_to_image?prompt=Snowland%20indoor%20snow%20park%20artificial%20ski%20resort%2C%20families%20skiing%20snowboarding%2C%20ice%20sculptures%2C%20polar%20theme%2C%20Gramado%20Brazil%20Serra%20Gaucha%20attraction%2C%20ParksNet&image_size=landscape_16_9",
    "https://coresg-normal.trae.ai/api/ide/v1/text_to_image?prompt=First%20NBA%20Park%20in%20the%20world%20basketball%20theme%20park%20Gramado%2C%20basketball%20courts%2C%20NBA%20logo%2C%20interactive%20games%2C%20sports%20entertainment%2C%20ParksNet%20Serra%20Gaucha&image_size=landscape_16_9",
    "https://coresg-normal.trae.ai/api/ide/v1/text_to_image?prompt=Skyglass%20Canela%20glass%20platform%20overlooking%20Ferradura%20Valley%2C%20stunning%20mountain%20landscape%2C%20adventure%20tourist%20attraction%2C%20people%20standing%20on%20transparent%20floor%2C%20ParksNet%20Brazil&image_size=landscape_16_9",
    "https://coresg-normal.trae.ai/api/ide/v1/text_to_image?prompt=Vila%20da%20Monica%20theme%20park%20characters%20Monica%20and%20friends%20mascots%2C%20Mauricio%20de%20Souza%20cartoon%20characters%2C%20children%20rides%2C%20colorful%20park%20Gramado%2C%20ParksNet%20Serra%20Gaucha&image_size=landscape_16_9",
    "https://coresg-normal.trae.ai/api/ide/v1/text_to_image?prompt=Alpen%20Park%20theme%20park%20roller%20coaster%20and%20Bondinhos%20Aereos%20Caracol%20aerial%20tramway%20cable%20cars%20mountain%20view%2C%20Mini%20Mundo%20miniature%20park%2C%20Space%20Adventure%20NASA%20park%2C%20ParksNet%20Gramado%20Canela&image_size=landscape_16_9"
  ],
  tags: [
    "Passaporte de parques",
    "Snowland",
    "NBA Park Gramado",
    "Skyglass Canela",
    "Vila da Mônica",
    "Alpen Park",
    "Bondinhos Aéreos"
  ]
};

const whatsappMessage = `Olá! Gostaria de mais informações sobre o ${passeio.titulo} - ${passeio.subtitulo}.`;
const whatsappUrl = `https://wa.me/5554993220552?text=${encodeURIComponent(whatsappMessage)}`;
---

<BaseLayout 
  title={`${passeio.titulo} - Ingressos | Serra Transfer - Gramado RS`}
  description="ParksNet! Passaporte para parques e atrações da Serra Gaúcha: Snowland, NBA Park, Skyglass, Vila da Mônica, Alpen Park e mais. Pague em até 10x!"
  keywords={['ParksNet', 'ingressos parques Gramado', 'Snowland', 'NBA Park Gramado', 'Skyglass Canela', 'Vila da Mônica', 'Alpen Park', 'Serra Transfer']}
  image={passeio.galeria[0]}
>
  <Header />
  
  <main class="pt-20 lg:pt-24">
    <!-- Hero Section -->
    <section class="relative h-96 lg:h-[500px] overflow-hidden" style={`background-image: url('${passeio.galeria[0]}'); background-attachment: fixed; background-size: cover; background-position: center; background-repeat: no-repeat;`}>
      <div class="absolute inset-0 bg-black/40"></div>
      <div class="absolute inset-0 flex items-center justify-center">
        <div class="text-center text-white px-4">
          <span class="inline-block px-3 py-1 bg-primary-600 text-white text-sm font-medium rounded-full mb-4">
            {passeio.categoria}
          </span>
          <h1 class="text-4xl lg:text-6xl font-bold mb-4">{passeio.titulo}</h1>
          <p class="text-xl lg:text-2xl text-gray-200">{passeio.subtitulo}</p>
        </div>
      </div>
    </section>

    <div class="container mx-auto px-4 py-12">
      <div class="grid lg:grid-cols-3 gap-12">
        <!-- Conteúdo Principal -->
        <div class="lg:col-span-3">

          <!-- Descrição -->
          <div class="mb-8">
            <h2 class="text-2xl font-bold mb-4">Sobre esta atração</h2>
            <p class="text-gray-700 leading-relaxed">{passeio.descricao}</p>
          </div>

          <!-- O que está incluso -->
          <div class="mb-8">
            <h3 class="text-xl font-bold mb-4">Benefícios ParksNet</h3>
            <ul class="space-y-2">
              {passeio.inclusos.map(item => (
                <li class="flex items-center space-x-3">
                  <svg class="w-5 h-5 text-green-500" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                  </svg>
                  <span class="text-gray-700">{item}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Duração e Horários -->
          <div class="mb-8 grid md:grid-cols-2 gap-6">
            <div class="bg-gray-50 p-6 rounded-lg">
              <h3 class="text-xl font-bold mb-3">Duração</h3>
              <p class="text-gray-700">{passeio.duracao}</p>
            </div>
            <div class="bg-gray-50 p-6 rounded-lg">
              <h3 class="text-xl font-bold mb-3">Horários</h3>
              <ul class="space-y-1">
                {passeio.horarios.map(horario => (
                  <li class="text-gray-700">🕐 {horario}</li>
                ))}
              </ul>
            </div>
          </div>

          <!-- Tags -->
          <div class="mb-8">
            <h3 class="text-xl font-bold mb-4">Atrações disponíveis</h3>
            <div class="flex flex-wrap gap-2">
              {passeio.tags.map(tag => (
                <span class="px-3 py-1 bg-primary-100 text-primary-700 rounded-full text-sm">
                  {tag}
                </span>
              ))}
            </div>
          </div>

          <!-- Botões CTA -->
          <div class="mb-8">
            <div class="grid md:grid-cols-2 gap-4">
              <a 
                href={passeio.linkOficial} 
                target="_blank" 
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center px-8 py-4 bg-red-600 hover:bg-red-700 text-white font-bold text-lg rounded-lg shadow-lg transition-all hover:shadow-xl transform hover:-translate-y-0.5"
              >
                🎟️ Comprar ingresso oficial
              </a>
              <a 
                href={whatsappUrl} 
                target="_blank" 
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center px-8 py-4 bg-green-600 hover:bg-green-700 text-white font-bold text-lg rounded-lg shadow-lg transition-all hover:shadow-xl transform hover:-translate-y-0.5"
              >
                💬 Falar com atendente no WhatsApp
              </a>
            </div>
          </div>

          <!-- Endereço -->
          <div class="mb-8">
            <h3 class="text-xl font-bold mb-4">Como funciona</h3>
            <div class="bg-gray-50 p-6 rounded-lg flex items-start space-x-4">
              <div class="flex-shrink-0">
                <svg class="w-8 h-8 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                </svg>
              </div>
              <div>
                <h4 class="font-bold text-gray-800">Entrega digital</h4>
                <p class="text-gray-700">{passeio.endereco}</p>
              </div>
            </div>
          </div>

          <!-- Galeria de Imagens -->
          <div class="mb-8">
            <h3 class="text-xl font-bold mb-4">Galeria de Atrações</h3>
            <div class="grid grid-cols-2 lg:grid-cols-3 gap-4">
              {passeio.galeria.map((imagem, index) => (
                <div class="aspect-square overflow-hidden rounded-lg cursor-pointer hover:opacity-80 transition-opacity">
                  <img 
                    src={imagem} 
                    alt={`${passeio.titulo} - Imagem ${index + 1}`}
                    class="w-full h-full object-cover"
                    onclick={`openModal('${imagem}')`}
                  />
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <!-- Modal para Galeria -->
  <div id="imageModal" class="fixed inset-0 bg-black/80 z-50 hidden items-center justify-center p-4">
    <div class="relative max-w-4xl max-h-full">
      <button 
        onclick="closeModal()"
        class="absolute -top-10 right-0 text-white hover:text-gray-300 text-2xl"
      >
        ✕
      </button>
      <img id="modalImage" src="" alt="" class="max-w-full max-h-full object-contain rounded-lg" />
    </div>
  </div>

  <Footer />
</BaseLayout>

<script>
  function openModal(imageSrc) {
    const modal = document.getElementById('imageModal');
    const modalImage = document.getElementById('modalImage');
    modalImage.src = imageSrc;
    modal.classList.remove('hidden');
    modal.classList.add('flex');
  }

  function closeModal() {
    const modal = document.getElementById('imageModal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
  }

  document.getElementById('imageModal').addEventListener('click', function(e) {
    if (e.target === this) {
      closeModal();
    }
  });
</script>
