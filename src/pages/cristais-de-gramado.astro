---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StarRating from '../components/StarRating.astro';

const passeio = {
  titulo: "Cristais de Gramado",
  subtitulo: "Ingresso",
  categoria: "INGRESSOS E ATRAÇÕES",
  avaliacao: 4.67,
  totalAvaliacoes: 6,
  descricao: "Descubra a magia dos cristais na mais artística fábrica de cristal Murano da América do Sul. Uma experiência única onde você pode acompanhar ao vivo todo o processo de produção artística dos cristais, desde o derretimento até a criação de peças únicas. O tour inclui o espetáculo 'A Voz do Cristal', uma apresentação emocionante que combina música, luz e a beleza dos cristais em uma experiência sensorial inesquecível.",
  inclusos: [
    "Ingresso para a fábrica",
    "Tour guiado pela produção",
    "Espetáculo 'A Voz do Cristal'",
    "Degustação de produtos locais",
    "Acesso à loja de cristais"
  ],
  duracao: "2 horas",
  horarios: ["09:00", "14:00", "16:00"],
  galeria: [
    "https://coresg-normal.trae.ai/api/ide/v1/text_to_image?prompt=Glass%20crystal%20factory%20exhibition%20interior%20with%20glowing%20murano%20chandeliers%20and%20artisan%20glass%20blowing%20demonstration%2C%20Gramado%20Brazil%20Serra%20Gaucha%20tourist%20attraction&image_size=landscape_16_9",
    "https://coresg-normal.trae.ai/api/ide/v1/text_to_image?prompt=Murano%20crystal%20glass%20blowing%20artisan%20workshop%20factory%20tour%20interior%2C%20Gramado%20craftsman%20working%20with%20molten%20glass&image_size=landscape_16_9",
    "https://coresg-normal.trae.ai/api/ide/v1/text_to_image?prompt=Elegant%20glowing%20crystal%20chandelier%20showroom%20luxury%20glass%20art%20exhibition%20sparkling%20reflections&image_size=landscape_16_9",
    "https://coresg-normal.trae.ai/api/ide/v1/text_to_image?prompt=The%20voice%20of%20crystal%20live%20musical%20performance%20with%20crystal%20glass%20instruments%2C%20Gramado%20stage%20show%20lights&image_size=landscape_16_9",
    "https://coresg-normal.trae.ai/api/ide/v1/text_to_image?prompt=Luxury%20crystal%20glassware%20display%20store%20shop%20beautiful%20handmade%20vases%20bowls%20artisan%20products&image_size=landscape_16_9",
    "https://coresg-normal.trae.ai/api/ide/v1/text_to_image?prompt=Glass%20art%20sculpture%20exhibition%20colorful%20murano%20crystal%20pieces%20museum%20display%20lighting%20effects&image_size=landscape_16_9"
  ],
  tags: ["Fábrica de cristal Murano", "Tour ao vivo da produção artística", "Espetáculo 'A Voz do Cristal'"]
};

const whatsappMessage = `Olá! Gostaria de mais informações sobre o ${passeio.titulo} - ${passeio.subtitulo}.`;
const whatsappUrl = `https://wa.me/5554993220552?text=${encodeURIComponent(whatsappMessage)}`;
---

<BaseLayout 
  title={`${passeio.titulo} - Ingresso | Serra Transfer - Gramado RS`}
  description="Ingresso para Cristais de Gramado! Acompanhe a produção de cristais Murano ao vivo e assista ao espetáculo 'A Voz do Cristal' com a Serra Transfer!"
  keywords={['Cristais de Gramado', 'ingresso Cristais de Gramado', 'fabrica de cristais RS', 'espetáculo A Voz do Cristal', 'Serra Transfer']}
  image={passeio.galeria[0]}
>
  <Header />
  
  <main class="pt-20 lg:pt-24">
    <!-- Hero Section -->
    <section class="relative h-96 lg:h-[500px] overflow-hidden" style={`background-image: url('${passeio.galeria[0]}'); background-attachment: fixed; background-size: cover; background-position: center; background-repeat: no-repeat;`}>
      <div class="absolute inset-0 bg-black/40"></div>
      <div class="absolute inset-0 flex items-center justify-center">
        <div class="text-center text-white px-4">
          <span class="inline-block px-3 py-1 bg-primary-600 text-white text-sm font-medium rounded-full mb-4">
            {passeio.categoria}
          </span>
          <h1 class="text-4xl lg:text-6xl font-bold mb-4">{passeio.titulo}</h1>
          <p class="text-xl lg:text-2xl text-gray-200">{passeio.subtitulo}</p>
        </div>
      </div>
    </section>

    <div class="container mx-auto px-4 py-12">
      <div class="grid lg:grid-cols-3 gap-12">
        <!-- Conteúdo Principal -->
        <div class="lg:col-span-3">

          <!-- Descrição -->
          <div class="mb-8">
            <h2 class="text-2xl font-bold mb-4">Sobre esta atração</h2>
            <p class="text-gray-700 leading-relaxed">{passeio.descricao}</p>
          </div>

          <!-- O que está incluso -->
          <div class="mb-8">
            <h3 class="text-xl font-bold mb-4">O que está incluso</h3>
            <ul class="space-y-2">
              {passeio.inclusos.map(item => (
                <li class="flex items-center space-x-3">
                  <svg class="w-5 h-5 text-green-500" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                  </svg>
                  <span class="text-gray-700">{item}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Tags -->
          <div class="mb-8">
            <h3 class="text-xl font-bold mb-4">Destaques</h3>
            <div class="flex flex-wrap gap-2">
              {passeio.tags.map(tag => (
                <span class="px-3 py-1 bg-primary-100 text-primary-700 rounded-full text-sm">
                  {tag}
                </span>
              ))}
            </div>
          </div>

          <!-- Galeria de Imagens -->
          <div class="mb-8">
            <h3 class="text-xl font-bold mb-4">Galeria</h3>
            <div class="grid grid-cols-2 lg:grid-cols-3 gap-4">
              {passeio.galeria.map((imagem, index) => (
                <div class="aspect-square overflow-hidden rounded-lg cursor-pointer hover:opacity-80 transition-opacity">
                  <img 
                    src={imagem} 
                    alt={`${passeio.titulo} - Imagem ${index + 1}`}
                    class="w-full h-full object-cover"
                    onclick={`openModal('${imagem}')`}
                  />
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <!-- Modal para Galeria -->
  <div id="imageModal" class="fixed inset-0 bg-black/80 z-50 hidden items-center justify-center p-4">
    <div class="relative max-w-4xl max-h-full">
      <button 
        onclick="closeModal()"
        class="absolute -top-10 right-0 text-white hover:text-gray-300 text-2xl"
      >
        ✕
      </button>
      <img id="modalImage" src="" alt="" class="max-w-full max-h-full object-contain rounded-lg" />
    </div>
  </div>

  <Footer />
</BaseLayout>

<script>
  function openModal(imageSrc) {
    const modal = document.getElementById('imageModal');
    const modalImage = document.getElementById('modalImage');
    modalImage.src = imageSrc;
    modal.classList.remove('hidden');
    modal.classList.add('flex');
  }

  function closeModal() {
    const modal = document.getElementById('imageModal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
  }

  // Fechar modal ao clicar fora da imagem
  document.getElementById('imageModal').addEventListener('click', function(e) {
    if (e.target === this) {
      closeModal();
    }
  });
</script>